// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © options-agent — Volume Zones · لوحة: نافذة مرافقة تحت الشموع (reports/vol_engine, reports/vol_engine_dev, 2026-10-25).
// v31: every element has its own settings group. v27: the 40-item review. The seasonal profile is aligned to the New York clock, the session comes from the symbol's
// regular session (length from its daily close), the fan is a time-based curve, exits are measured against that fan,
// the old modes are gone.
//@version=6
// Drawing budget (worst case): strips 2 boxes per bar on the last 200 bars (one per 2 bars above 200) = 400 + 2 live;
// live fan 2 boxes + ~8 lines + ~8 labels + 4 polylines; ghosts 2 boxes + 3 lines + 1 label each (20 = 40 / 60 / 20);
// day ranges 2 lines per session (20 = 40) + 2 labels. Total ≈ 444 boxes, 110 lines, 32 labels, 4 polylines; a guard
// stops drawing ghosts when the box count would pass 480.
indicator("Volume Zones · لوحة", "VZ لوحة", overlay=false, format=format.price, precision=2, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_polylines_count=20)

// ═══════════════ المدخلات: كلّ عنصر في مجموعته (إظهار، لون، سماكة، نمط، حجم نصّ) ═══════════════
G_A = "1 · الأساس"
pFanMode = input.string("الجلسة كاملة", "أفق المروحة", options=["الجلسة كاملة", "أفق قصير يتجدّد"], tooltip="الجلسة كاملة: المروحة والأهداف ونطاق اليوم تبدأ من افتتاح الجلسة العادية وتنتهي بإغلاقها، ولا تتحرّك، وتتجدّد مع اليوم الجديد. المروحة منحنى يكبر مع الوقت حسب نمط التذبذب خلال اليوم. أفق قصير: مروحة بأفق حسب الفريم تتجدّد كلّما بقي أمام السعر أقلّ من N شمعة", group=G_A)
pWin    = input.int(0, "عدد الشموع المعروضة (0 = تلقائي)", minval=0, maxval=400, tooltip="تلقائي: جلسة ونصف (بين 60 و400 شمعة). المروحة تمتدّ أمام السعر حتى الإغلاق، فاضبط «الهامش الأيمن» في إعدادات الشارت بما يكفي", group=G_A)
pScale  = input.string("الشموع و±1σ", "مقياس اللوحة يشمل", options=["الشموع فقط", "الشموع و±1σ", "الشموع و±2σ"], tooltip="ما يدخل في المقياس التلقائي للّوحة. ±2σ لليوم كاملًا يضغط الشموع", group=G_A)
pLead   = input.int(5, "الأفق القصير: شموع أمام السعر على الأقلّ", minval=3, maxval=20, tooltip="للأفق القصير فقط: عندما يبقى أمام السعر هذا العدد من الشموع حتى نهاية أفق المروحة تُفتح مرساة جديدة", group=G_A)
pSessMin = input.int(0, "طول الجلسة بالدقائق (0 = تلقائي)", minval=0, maxval=1440, tooltip="تلقائي: من الجلسة العادية للرمز نفسه، وطولها من وقت إغلاق اليوم (أنصاف أيّام العطل محسوبة)", group=G_A)

G_K = "2 · الشموع"
pCandles = input.bool(true, "إظهار الشموع", inline="k0", group=G_K)
pCandleSrc = input.string("تلقائي", "النوع", options=["تلقائي", "عادية", "هايكن آشي"], inline="k0", tooltip="تلقائي: هايكن آشي إذا كان الشارت هايكن آشي. الحسابات كلّها على الشموع العادية دائمًا؛ هذا للعرض فقط", group=G_K)
cUp   = input.color(#26a69a, "صعود", inline="k1", group=G_K)
cDn   = input.color(#ef5350, "هبوط", inline="k1", group=G_K)
pRvHi = input.bool(true, "إبراز الفوليوم العالي", inline="k2", tooltip="إطار وفتيل الشمعة بهذا اللون عندما يكون حجمها أعلى من المعتاد لنفس الوقت بهذه النسبة أو أكثر (RVOL). مقيس: يتنبّأ باتّساع المدى لا بالاتجاه", group=G_K)
cRvHi = input.color(#ffd600, "", inline="k2", group=G_K)
pRvThr = input.float(2.0, "عند RVOL ≥", minval=1.0, maxval=5.0, step=0.1, inline="k2", group=G_K)

G_B1 = "3 · مربّع المروحة ±1σ"
pBox1  = input.bool(true, "إظهار", inline="b1", group=G_B1)
cBox1  = input.color(color.new(#29b6f6, 86), "التعبئة", inline="b1", group=G_B1)
cBox1B = input.color(color.new(#29b6f6, 70), "الإطار", inline="b1", group=G_B1)

G_B2 = "4 · مربّع المروحة ±2σ"
pBox2  = input.bool(true, "إظهار", inline="b2", group=G_B2)
cBox2  = input.color(color.new(#29b6f6, 94), "التعبئة", inline="b2", group=G_B2)
cBox2B = input.color(color.new(#29b6f6, 80), "الإطار", inline="b2", group=G_B2)

G_CV = "5 · منحنيات المروحة"
pCv1 = input.bool(true, "منحنى ±1σ", inline="c1", group=G_CV)
cCv1 = input.color(color.new(#29b6f6, 10), "", inline="c1", group=G_CV)
wCv1 = input.int(2, "", minval=1, maxval=5, inline="c1", group=G_CV)
sCv1 = input.string("متقطّع", "", options=["متّصل", "متقطّع", "منقّط"], inline="c1", group=G_CV)
pCv2 = input.bool(true, "منحنى ±2σ", inline="c2", group=G_CV)
cCv2 = input.color(color.new(#29b6f6, 45), "", inline="c2", group=G_CV)
wCv2 = input.int(1, "", minval=1, maxval=5, inline="c2", group=G_CV)
sCv2 = input.string("متقطّع", "", options=["متّصل", "متقطّع", "منقّط"], inline="c2", group=G_CV)

G_OP = "6 · الافتتاح (المرساة)"
pOpenLn = input.bool(true, "خطّ الافتتاح", inline="o1", group=G_OP)
cOpenLn = input.color(color.new(#ef5350, 30), "", inline="o1", group=G_OP)
wOpenLn = input.int(1, "", minval=1, maxval=5, inline="o1", group=G_OP)
sOpenLn = input.string("منقّط", "", options=["متّصل", "متقطّع", "منقّط"], inline="o1", group=G_OP)
pOpenLbl = input.bool(true, "ملصق الافتتاح", inline="o2", group=G_OP)
cOpenBg = input.color(color.new(#ef5350, 20), "الخلفية", inline="o2", group=G_OP)
cOpenTx = input.color(color.white, "النصّ", inline="o2", group=G_OP)
szOpenK = input.string("عادي", "الحجم", options=["صغير جدًا", "صغير", "عادي", "كبير"], inline="o2", group=G_OP)

G_T1 = "7 · أهداف ±1σ"
pT1 = input.bool(true, "خطّا ±1σ", inline="t1", group=G_T1)
cT1 = input.color(#c6ff00, "", inline="t1", group=G_T1)
wT1 = input.int(2, "", minval=1, maxval=5, inline="t1", group=G_T1)
sT1 = input.string("متقطّع", "", options=["متّصل", "متقطّع", "منقّط"], inline="t1", group=G_T1)
pT1Lbl = input.bool(true, "الملصقات", inline="t1b", group=G_T1)
szT1K = input.string("عادي", "الحجم", options=["صغير جدًا", "صغير", "عادي", "كبير"], inline="t1b", group=G_T1)

G_T2 = "8 · أهداف ±2σ"
pT2 = input.bool(true, "خطّا ±2σ", inline="t2", group=G_T2)
cT2 = input.color(color.new(#c6ff00, 35), "", inline="t2", group=G_T2)
wT2 = input.int(1, "", minval=1, maxval=5, inline="t2", group=G_T2)
sT2 = input.string("متقطّع", "", options=["متّصل", "متقطّع", "منقّط"], inline="t2", group=G_T2)
pT2Lbl = input.bool(true, "الملصقات", inline="t2b", group=G_T2)
szT2K = input.string("عادي", "الحجم", options=["صغير جدًا", "صغير", "عادي", "كبير"], inline="t2b", group=G_T2)

G_ST = "9 · الوقف الثابت (الأفق القصير فقط)"
pStop = input.bool(true, "خطّ الوقف 0.75×", inline="s1", group=G_ST)
cStop = input.color(#ef5350, "", inline="s1", group=G_ST)
wStop = input.int(2, "", minval=1, maxval=5, inline="s1", group=G_ST)
sStop = input.string("متّصل", "", options=["متّصل", "متقطّع", "منقّط"], inline="s1", group=G_ST)
pStopLbl = input.bool(true, "الملصق", inline="s1b", group=G_ST)
szStopK = input.string("عادي", "الحجم", options=["صغير جدًا", "صغير", "عادي", "كبير"], inline="s1b", group=G_ST)

G_DY = "10 · نطاق اليوم المتوقّع"
pDay = input.bool(true, "خطّا النطاق", inline="d1", group=G_DY)
cDayL = input.color(color.new(#b388ff, 20), "", inline="d1", group=G_DY)
wDay = input.int(2, "", minval=1, maxval=5, inline="d1", group=G_DY)
sDay = input.string("متقطّع", "", options=["متّصل", "متقطّع", "منقّط"], inline="d1", group=G_DY)
pDayPast = input.bool(true, "نطاق الجلسات السابقة", group=G_DY)
pDayLbl = input.bool(true, "الملصقات", inline="d2", group=G_DY)
szDayK = input.string("عادي", "الحجم", options=["صغير جدًا", "صغير", "عادي", "كبير"], inline="d2", group=G_DY)

G_RM = "11 · المتبقّي حتى الإغلاق"
pRem = input.bool(true, "الخطّان", inline="r1", group=G_RM)
cRem = input.color(color.new(#29b6f6, 30), "", inline="r1", group=G_RM)
wRem = input.int(1, "", minval=1, maxval=5, inline="r1", group=G_RM)
sRem = input.string("منقّط", "", options=["متّصل", "متقطّع", "منقّط"], inline="r1", group=G_RM)
pRemLbl = input.bool(true, "الملصق", inline="r2", group=G_RM)
szRemK = input.string("عادي", "الحجم", options=["صغير جدًا", "صغير", "عادي", "كبير"], inline="r2", group=G_RM)

G_TR = "12 · الوقف المتحرّك"
pTrail = input.bool(true, "إظهار", inline="tr0", group=G_TR)
wTrail = input.int(2, "السماكة", minval=1, maxval=5, inline="tr0", group=G_TR)
cTrUp  = input.color(#26a69a, "صاعد", inline="tr1", group=G_TR)
cTrDn  = input.color(#ef5350, "هابط", inline="tr1", group=G_TR)
cTrHit = input.color(color.new(#78909c, 20), "مضروب", inline="tr1", group=G_TR)
pTrLbl = input.bool(true, "الملصق", inline="tr2", group=G_TR)
szTrK  = input.string("عادي", "الحجم", options=["صغير جدًا", "صغير", "عادي", "كبير"], inline="tr2", group=G_TR)

G_EX = "13 · أسهم الخروج من المروحة"
pExits = input.bool(true, "إظهار", inline="e1", group=G_EX)
cExUp  = input.color(#26a69a, "فوق ▲", inline="e1", group=G_EX)
cExDn  = input.color(#ef5350, "تحت ▼", inline="e1", group=G_EX)

G_GH = "14 · المراوح القديمة"
pGhost = input.int(10, "أقصى عدد", minval=0, maxval=20, tooltip="تُرسم فقط المراوح التي تقع داخل النافذة. ✓ 1× أو ✓ 2× = وصل السعر الهدف قبل الوقف، ✗ = ضرب الوقف أوّلًا، — = لا هذا ولا ذاك. في وضع الجلسة المروحة متماثلة بلا وقف", inline="g0", group=G_GH)
cGh    = input.color(color.new(#29b6f6, 80), "الإطار", inline="g0", group=G_GH)
pGhLbl = input.bool(true, "النتيجة", inline="g1", group=G_GH)
cGhWin = input.color(#26a69a, "✓", inline="g1", group=G_GH)
cGhLoss = input.color(#ef5350, "✗", inline="g1", group=G_GH)
cGhNone = input.color(#5d606b, "—", inline="g1", group=G_GH)
szGhK  = input.string("عادي", "الحجم", options=["صغير جدًا", "صغير", "عادي", "كبير"], inline="g2", group=G_GH)

G_HT = "15 · شريط الحرارة"
pHeatS  = input.bool(true, "إظهار", inline="h0", group=G_HT)
pHeatH  = input.float(3.5, "الارتفاع % من اللوحة", minval=0.5, maxval=15, step=0.5, inline="h0", group=G_HT)
cHeat0  = input.color(#1a1a2e, "بارد", inline="h1", group=G_HT)
cHeat50 = input.color(#1e88e5, "متوسّط", inline="h1", group=G_HT)
cHeat100 = input.color(#ffd600, "ساخن", inline="h1", group=G_HT)
cHeatNA = input.color(#5d606b, "بلا بيانات", inline="h1", group=G_HT)
pStripGap = input.float(4.0, "المسافة تحت الرسم % من اللوحة", minval=0, maxval=20, step=0.5, group=G_HT)
pHeatLbl = input.bool(true, "العنوان", inline="h2", group=G_HT)
cHeatTx = input.color(#ffd600, "", inline="h2", group=G_HT)
szHeatK = input.string("عادي", "الحجم", options=["صغير جدًا", "صغير", "عادي", "كبير"], inline="h2", group=G_HT)

G_SQ = "16 · شريط الانضغاط"
pSqzS   = input.bool(true, "إظهار", inline="q0", group=G_SQ)
pSqzH   = input.float(3.5, "الارتفاع % من اللوحة", minval=0.5, maxval=15, step=0.5, inline="q0", group=G_SQ)
cSqzOn  = input.color(#ab47bc, "انضغاط", inline="q1", group=G_SQ)
cSqzOff = input.color(#2a2e39, "بلا انضغاط", inline="q1", group=G_SQ)
pSqzLbl = input.bool(true, "العنوان", inline="q2", group=G_SQ)
cSqzTx  = input.color(#ab47bc, "", inline="q2", group=G_SQ)
szSqzK  = input.string("عادي", "الحجم", options=["صغير جدًا", "صغير", "عادي", "كبير"], inline="q2", group=G_SQ)

G_SB = "17 · مربّع «الحالة الآن»"
pBox    = input.bool(true, "إظهار المربّع", inline="sb", group=G_SB)
pBoxPos = input.string("وسط اليمين", "", options=["وسط اليمين", "أعلى اليمين", "أسفل اليمين", "أعلى اليسار", "وسط اليسار", "أسفل اليسار"], inline="sb", group=G_SB)
pTblSz  = input.string("صغير", "حجم النصّ", options=["صغير جدًا", "صغير", "عادي", "كبير"], inline="sb2", group=G_SB)
pCompact = input.bool(false, "مختصر (6 أسطر)", inline="sb2", group=G_SB)
pTblAuto = input.bool(true, "ألوان المربّع تلقائية حسب الثيم", tooltip="مفعّل: الخلفية والإطار والنصوص تتبع ثيم الشارت الفاتح أو الداكن. معطّل: الألوان أدناه", group=G_SB)
cTblBgIn = input.color(#1e222d, "الخلفية", inline="sb3", group=G_SB)
pTblAlpha = input.int(8, "شفافيتها", minval=0, maxval=90, step=5, inline="sb3", group=G_SB)
cTblFrIn = input.color(#3a3f4b, "الإطار", inline="sb4", group=G_SB)
cTblLblIn = input.color(#9598a1, "العناوين", inline="sb4", group=G_SB)
cTblTxIn = input.color(#d1d4dc, "النصّ", inline="sb4", group=G_SB)
cVerdict = input.color(#ffd600, "الخلاصة", inline="sb5", group=G_SB)

G_SR = "18 · صفوف المربّع"
rDir  = input.bool(true, "الاتجاه", inline="r1", group=G_SR)
rMove = input.bool(true, "الحركة", inline="r1", group=G_SR)
rTgt  = input.bool(true, "الأهداف", inline="r1", group=G_SR)
rTgt2 = input.bool(true, "±2σ / الوقف", inline="r2", group=G_SR)
rTr   = input.bool(true, "الوقف المتحرّك", inline="r2", group=G_SR)
rVol  = input.bool(true, "الفوليوم", inline="r2", group=G_SR)
rRem  = input.bool(true, "حتى الإغلاق", inline="r3", group=G_SR)
rHeat = input.bool(true, "الحرارة", inline="r3", group=G_SR)
rSqz  = input.bool(true, "الانضغاط", inline="r3", group=G_SR)
rExit = input.bool(true, "الخروج", inline="r4", group=G_SR)
rDist = input.bool(true, "من المرساة", inline="r4", group=G_SR)
rWarn = input.bool(true, "تنبيه الفريم", inline="r4", group=G_SR)
rVerd = input.bool(true, "الخلاصة", inline="r5", group=G_SR)

szOf(string k) => k == "صغير جدًا" ? size.tiny : k == "صغير" ? size.small : k == "كبير" ? size.large : size.normal
szUp(string k) => k == "صغير جدًا" ? size.small : k == "صغير" ? size.normal : size.large
stOf(string k) => k == "متّصل" ? line.style_solid : k == "منقّط" ? line.style_dotted : line.style_dashed
tsz = szOf(pTblSz)
tszH = szUp(pTblSz)
szOpen = szOf(szOpenK)
szT1 = szOf(szT1K)
szT2 = szOf(szT2K)
szStop = szOf(szStopK)
szDay = szOf(szDayK)
szRem = szOf(szRemK)
szTr = szOf(szTrK)
szGh = szOf(szGhK)
szHeat = szOf(szHeatK)
szSqz = szOf(szSqzK)
// element switches that several drawings share
bool pFan = pBox1 or pBox2 or pCv1 or pCv2 or pOpenLn or pOpenLbl
bool pLadder = pT1 or pT2 or pStop
bool pStrips = pHeatS or pSqzS
// value colours in the status box follow their element
color cMove  = color.new(cCv1, 0)
color cTgt   = color.new(cT1, 0)
color cHot   = cVerdict
color cNorm  = cHeatNA
color cSqz   = cSqzOn
color cTrail = cTrUp
color cHitC  = cTrHit
color cOff   = cSqzOff
color cCold  = cHeat0

// theme (25): the box follows the chart's light or dark background unless its colours are set by hand
float bgLum = 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color)
bool dark = bgLum < 128
color cTxt   = pTblAuto ? (dark ? #d1d4dc : #131722) : cTblTxIn
color cDim   = pTblAuto ? (dark ? #9598a1 : #50535e) : cTblLblIn
color cPanel = pTblAuto ? (dark ? #1e222d : #f0f3fa) : cTblBgIn
color cFrame = pTblAuto ? (dark ? #3a3f4b : #b2b5be) : cTblFrIn

// ═══════════════ الشموع الحقيقية (نفس قاعدة المؤشّر الرئيسي) ═══════════════
stdT0 = ticker.standard(syminfo.tickerid)
stdT = str.contains(syminfo.tickerid, "dividends") ? ticker.modify(stdT0, syminfo.session, adjustment.dividends) : stdT0
[o_, h_, l_, c_] = request.security(stdT, timeframe.period, [open, high, low, close], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
trR = na(c_[1]) ? h_ - l_ : math.max(h_ - l_, math.max(math.abs(h_ - c_[1]), math.abs(l_ - c_[1])))
atrV = ta.rma(trR, 14)
bool warm = bar_index >= 100                                                        // (34) variance settled

// ═══════════════ الجلسة: الجلسة العادية للرمز نفسه (2، 10، 12) ═══════════════
int tfMin = timeframe.isintraday ? (timeframe.isseconds ? 1 : timeframe.multiplier) : 390
int tfMs  = tfMin * 60000
bool seasonal = timeframe.isintraday and not timeframe.isseconds                    // (31) no seasonality under a minute
bool longSess = syminfo.type == "futures" or syminfo.type == "crypto" or syminfo.type == "forex"
int nSlotsMax = seasonal ? math.max(1, math.ceil((longSess ? 1440.0 : 960.0) / tfMin)) : 1   // (39)
bool inMkt = timeframe.isintraday ? session.ismarket : true
bool sessFirst = timeframe.isintraday and session.isfirstbar_regular
var int sessStartMs = na
var int[] sessLens = array.new_int()
var int lastMinsIn = na
if sessFirst
    if not na(lastMinsIn)
        array.push(sessLens, lastMinsIn + tfMin)
        if array.size(sessLens) > 5
            array.shift(sessLens)
    sessStartMs := time
int minsIn = inMkt and not na(sessStartMs) ? math.round((time - sessStartMs) / 60000.0) : -1
if minsIn >= 0
    lastMinsIn := minsIn
// length: the day's own close time on a regular-session chart (handles half days and the first day), else the
// longest of the last five sessions; never shorter than what has already traded today
int tcD = time_close("D")
int sessExact = syminfo.session == session.regular and not na(tcD) and not na(sessStartMs) and tcD > sessStartMs ? math.round((tcD - sessStartMs) / 60000.0) : na
int sessHist = array.size(sessLens) > 0 ? array.max(sessLens) : (longSess ? 1380 : 390)
int sessMin0 = pSessMin > 0 ? pSessMin : nz(sessExact, sessHist)
int sessMin = math.max(sessMin0, minsIn >= 0 ? minsIn + tfMin : 0)
int nSlots = seasonal ? math.max(1, math.min(nSlotsMax, math.ceil(sessMin / float(tfMin)))) : 1
int slotNow = not timeframe.isintraday ? 0 : not seasonal ? (inMkt ? 0 : -1) : (minsIn < 0 ? -1 : math.min(nSlots - 1, math.floor(minsIn / tfMin)))
int sessEndMs = na(sessStartMs) ? na : sessStartMs + sessMin * 60000

// ═══════════════ النمط الموسمي على ساعة نيويورك (1) ═══════════════
// The measured 5-minute profile is US-equity RTH (09:30–16:00 New York). Each session slot reads the profile at its
// New York clock time, so VIX (03:15 open) gets the 13× factor at 09:30, not at 03:15. Outside 09:30–16:00 the factor
// is 1.0 (the profile's mean); that part is not measured.
var float[] veProf5 = array.from(13.0616, 4.8267, 3.6186, 3.5973, 2.9083, 2.2205, 2.5626, 1.8878, 1.6552, 1.5478, 1.5150, 1.3400, 1.3999, 1.3048, 1.1005, 1.0198, 1.0875, 0.9432, 0.9621, 0.9115, 0.8946, 0.7789, 0.8649, 0.7575, 0.7734, 0.7263, 0.6908, 0.6309, 0.6126, 0.5490, 0.6428, 0.5213, 0.5306, 0.5239, 0.5307, 0.4423, 0.5344, 0.4355, 0.4537, 0.4399, 0.4756, 0.4301, 0.4941, 0.3874, 0.4243, 0.4877, 0.4332, 0.4195, 0.4622, 0.4479, 0.3848, 0.3877, 0.3981, 0.3667, 0.5075, 0.4125, 0.3680, 0.3705, 0.3549, 0.3387, 0.4077, 0.3518, 0.3282, 0.2971, 0.3384, 0.3667, 0.4148, 0.4013, 0.3611, 0.3712, 0.3645, 0.3211, 0.4269, 0.3818, 0.4306, 0.4423, 0.9771, 0.8611)
var float[] veG5 = array.from(7.830, 7.297, 6.952, 6.700, 6.509, 6.301, 5.940, 5.879, 5.761, 5.646, 5.554, 5.505, 5.380, 5.218, 5.228, 5.100, 5.001, 4.960, 4.825, 4.775, 4.668, 4.679, 4.566, 4.549, 4.489, 4.436, 4.442, 4.389, 4.335, 4.314, 4.275, 4.245, 4.210, 4.128, 4.122, 4.119, 4.023, 3.989, 3.910, 3.874, 3.801, 3.785, 3.708, 3.711, 3.771, 3.747, 3.678, 3.618, 3.554, 3.465, 3.425, 3.409, 3.370, 3.317, 3.252, 3.197, 3.157, 3.115, 3.049, 2.952, 2.930, 2.891, 2.795, 2.728, 2.635, 2.599, 2.439, 2.364, 2.290, 2.197, 2.096, 2.037, 1.909, 1.821, 1.667, 1.462, 0.980, 0.000)
profAtMin(int m) =>
    float sF = 0.0
    int nF = 0
    int lo5 = math.floor(m / 5.0)
    int hi5 = math.floor((m + tfMin - 1) / 5.0)
    for q = lo5 to hi5
        if q >= 0 and q < 78
            sF += array.get(veProf5, q)
            nF += 1
    nF > 0 ? sF / nF : 1.0
var float[] veProf = array.new_float()
var float[] veCum = array.new_float()                 // cumulative profile through slot s
if seasonal and sessFirst
    int offMin = hour(time, "America/New_York") * 60 + minute(time, "America/New_York") - 570
    array.clear(veProf)
    array.clear(veCum)
    float acc = 0.0
    for s = 0 to nSlots - 1
        float f = profAtMin(offMin + s * tfMin)
        array.push(veProf, f)
        acc += f
        array.push(veCum, acc)
pf(int s) => s >= 0 and s < array.size(veProf) ? array.get(veProf, s) : 1.0
cumThrough(int s) => array.size(veCum) == 0 ? s + 1.0 : array.get(veCum, math.max(0, math.min(array.size(veCum) - 1, s)))
float totDay = array.size(veCum) > 0 ? array.get(veCum, array.size(veCum) - 1) : nSlots

// ═══════════════ RVOL حسب وقت اليوم ═══════════════
var matrix<float> rvBuf = matrix.new<float>(nSlotsMax, 20, na)
float rvBase = na
if slotNow >= 0
    rvVals = array.new_float()
    for j = 0 to 19
        rvx = matrix.get(rvBuf, slotNow, j)
        if not na(rvx)
            array.push(rvVals, rvx)
    if array.size(rvVals) >= 10
        rvBase := array.median(rvVals)
float rvol = na(rvBase) or rvBase <= 0 ? na : volume / rvBase
if barstate.isconfirmed and slotNow >= 0
    for j = 0 to 18
        matrix.set(rvBuf, slotNow, j, matrix.get(rvBuf, slotNow, j + 1))
    matrix.set(rvBuf, slotNow, 19, volume)
// (19) the live bar's volume is compared with the part of a bar that has elapsed
float liveFrac = barstate.isrealtime ? math.max(0.05, math.min(1.0, (timenow - time) / float(tfMs))) : 1.0
float rvolShow = na(rvol) ? na : rvol / liveFrac
bool noVol = ta.cum(nz(volume)) == 0                                                  // (28) index symbols

// ═══════════════ نموذج الاتجاه ═══════════════
// (31) HMA length: 67 bars measured on 5m; under 5m the same DURATION (67 × 5 minutes)
int tvmLen = tfMin < 5 ? math.min(200, int(math.round(67 * 5.0 / tfMin))) : tfMin <= 5 ? 67 : tfMin <= 15 ? 66 : 56
tvM  = ta.hma(c_, tvmLen)
tvSl = tvM - tvM[1]
int tvState = c_ > tvM and tvSl > 0 and tvSl[1] > 0 and tvSl[2] > 0 ? 1 : c_ < tvM and tvSl < 0 and tvSl[1] < 0 and tvSl[2] < 0 ? -1 : 0
tvPath = math.sum(math.abs(ta.change(c_)), 20)
float tvI = tvPath > 0 ? math.abs(c_ - c_[20]) / tvPath : 0.0
float tvJ0 = math.sum((c_ - o_) / atrV, 10)
float tvS0 = 0.5 * tvI + 0.5 * math.min(1.0, math.abs(tvJ0) / 3.0)

// ═══════════════ محرّك التذبذب v2 ═══════════════
float veR = sessFirst or na(c_[1]) ? math.log(c_ / o_) : math.log(c_ / c_[1])
// (33) memory by duration: 5m 0.99 and 15m 0.97 as measured; other intraday frames keep the same half-life in minutes
float veLam = timeframe.isdwm ? 0.94 : tfMin == 5 ? 0.99 : tfMin == 15 ? 0.97 : tfMin < 15 ? math.pow(0.5, tfMin / 345.0) : 0.97
var float veS2 = na
veS2 := na(veS2) ? veR * veR : veLam * veS2 + (1 - veLam) * veR * veR
int veK = tfMin <= 5 ? 24 : tfMin <= 15 ? 8 : tfMin <= 60 ? 2 : 5
float veF = seasonal and slotNow >= 0 ? pf(slotNow) : 1.0
var float veS2d = na
veS2d := na(veS2d) ? veR * veR / veF : veLam * veS2d + (1 - veLam) * veR * veR / veF
float veNext = veK
if seasonal and slotNow >= 0
    float sN = 0.0
    for q = 1 to veK
        sN += pf((slotNow + q) % nSlots)
    veNext := sN
float veS2k = seasonal ? veS2d * veNext : veK * veS2
float veMove = timeframe.isdwm ? math.sqrt(2.701088) * atrV * math.sqrt(veK / 5.0) : math.sqrt(veS2k) * c_
float veA100 = ta.rma(trR, 100)
float veComp = veA100 > 0 ? atrV / veA100 : na
float veThr = timeframe.isdwm ? 0.8833 : 0.6967
bool veSqzOn = veComp < veThr
var int veSqzBars = 0
veSqzBars := veSqzOn ? veSqzBars + 1 : 0
bool veLunch = sessMin == 390 and minsIn >= 150 and minsIn < 240
// heat: rank against the same slot of the previous 20 sessions
var matrix<float> veHBuf = matrix.new<float>(nSlotsMax, 20, na)
float vePct = na
int veHeatN = 0
if slotNow >= 0 and not na(veMove)
    int veBelow = 0
    int veCnt = 0
    for j = 0 to 19
        float hx = matrix.get(veHBuf, slotNow, j)
        if not na(hx)
            veCnt += 1
            if hx < veMove / c_
                veBelow += 1
    veHeatN := veCnt
    if veCnt >= 10
        vePct := 100.0 * veBelow / veCnt
if barstate.isconfirmed and slotNow >= 0 and not na(veMove)
    for j = 0 to 18
        matrix.set(veHBuf, slotNow, j, matrix.get(veHBuf, slotNow, j + 1))
    matrix.set(veHBuf, slotNow, 19, veMove / c_)
int accN = math.max(1, int(math.round(60.0 / tfMin)))                                // (16) one hour on every frame
bool veAccel = not na(vePct) and not na(vePct[accN]) and vePct - vePct[accN] >= 20
// target odds by trend strength (H4.3): measured on 5m for a 24-bar horizon only (5, 32)
int veQ = tvS0 > 0.5879 ? 4 : tvS0 > 0.4241 ? 3 : tvS0 > 0.2934 ? 2 : tvS0 > 0.183 ? 1 : 0
string veP1 = tvState > 0 and veQ == 4 ? "31%" : tvState != 0 and veQ == 0 ? "21%" : "25%"
string veP2 = tvState < 0 and veQ == 2 ? "7%" : "8%"
// trailing stop for the current trend state (H4.5): 0.75 × the measured 24-bar move, kept as measured (8)
var float veBest = na
var float veTrailD = na
var bool veHit = false
if tvState != tvState[1]
    veBest := tvState > 0 ? h_ : tvState < 0 ? l_ : na
    veTrailD := tvState != 0 ? 0.75 * veMove : na
    veHit := false
else if tvState > 0
    veBest := math.max(nz(veBest, h_), h_)
else if tvState < 0
    veBest := math.min(nz(veBest, l_), l_)
float veTrailStop = tvState > 0 ? veBest - veTrailD : tvState < 0 ? veBest + veTrailD : na
if not na(veTrailStop) and ((tvState > 0 and c_ < veTrailStop) or (tvState < 0 and c_ > veTrailStop))
    veHit := true
// remaining move to the close (H3.2): the table is measured on the 390-minute US session only
int veSlot5end = seasonal and slotNow >= 0 and sessMin == 390 ? math.min(77, math.max(0, math.floor((slotNow + 1) * tfMin / 5.0) - 1)) : -1
float veRemMove = veSlot5end >= 0 ? array.get(veG5, veSlot5end) * math.sqrt(veS2 * 5.0 / tfMin) * c_ : na

// ═══════════════ نطاق الجلسة: رقم واحد للمروحة ولخطّي اليوم (4) ═══════════════
// the whole session's move from the open: the seasonal sum over ALL its slots (the first bar included, since the
// range starts at the open), on the variance known before the open (21: available on the first tick)
float veS2dPrev = nz(veS2d[1], veS2d)
float dayMoveNow = seasonal ? math.sqrt(veS2dPrev * totDay) * o_ : math.sqrt(math.max(1, nSlots) * nz(veS2[1], veS2)) * o_
var float dOpen = na
var float dMove = na
var int[] dT0 = array.new_int()
var int[] dT1 = array.new_int()
var float[] dHi = array.new_float()
var float[] dLo = array.new_float()
if sessFirst and not na(dayMoveNow)
    dOpen := o_
    dMove := dayMoveNow
    array.push(dT0, time)
    array.push(dT1, sessEndMs)
    array.push(dHi, o_ + dayMoveNow)
    array.push(dLo, o_ - dayMoveNow)
    if array.size(dT0) > 20
        array.shift(dT0)
        array.shift(dT1)
        array.shift(dHi)
        array.shift(dLo)
float veDayHi = na(dOpen) ? na : dOpen + dMove
float veDayLo = na(dOpen) ? na : dOpen - dMove

// ═══════════════ المرساة ═══════════════
// session mode: the anchor is the regular session's open price, horizon = the session up to its close TIME (12),
// symmetric (15: no side from yesterday's trend), scored from the first bar (6).
// short mode: anchor on a confirmed bar at its close, horizon per timeframe capped to the session.
bool sessMode = pFanMode == "الجلسة كاملة" and seasonal
int veHbase = timeframe.isdwm ? 5 : tfMin <= 5 ? 24 : tfMin <= 15 ? 12 : tfMin <= 30 ? 8 : tfMin <= 60 ? 6 : 4
int barsLeft = na(sessEndMs) ? 9999 : math.max(0, math.floor((sessEndMs - time) / float(tfMs)) - 1)
int veH = seasonal and slotNow >= 0 ? math.max(3, math.min(veHbase, barsLeft)) : veHbase
float veNextH = veH
if seasonal and slotNow >= 0
    float sNH = 0.0
    for q = 1 to veH
        sNH += pf((slotNow + q) % nSlots)
    veNextH := sNH
float veMoveHNow = timeframe.isdwm ? math.sqrt(2.701088) * atrV * math.sqrt(veH / 5.0) : seasonal ? math.sqrt(veS2d * veNextH) * c_ : math.sqrt(veH * veS2) * c_
var int   aBar = na
var int   aFrom = na
var int   aT0 = na
var int   aT1 = na
var float aC = na
var float aMove = na
var float aTot = na
var float aCum = 0.0
var int   aH = 0
var int   aState = 0
var int   aRes = 0            // 0 none, 1 target 1x, 2 target 2x, -1 stop 0.75x first
var int   aSlot = -1
var bool  sessAnchored = false
var string aP1 = "25%"
var string aP2 = "8%"
var int[]   gT0 = array.new_int()
var int[]   gT1 = array.new_int()
var int[]   gFrom = array.new_int()
var float[] gC = array.new_float()
var float[] gMove = array.new_float()
var int[]   gState = array.new_int()
var int[]   gRes = array.new_int()
if sessFirst
    sessAnchored := false
score(int res, int st_, float c0, float m, float hi, float lo) =>
    int r = res
    bool t1 = st_ > 0 ? hi >= c0 + m : st_ < 0 ? lo <= c0 - m : (hi >= c0 + m or lo <= c0 - m)
    bool t2 = st_ > 0 ? hi >= c0 + 2 * m : st_ < 0 ? lo <= c0 - 2 * m : (hi >= c0 + 2 * m or lo <= c0 - 2 * m)
    bool sp = st_ > 0 ? lo <= c0 - 0.75 * m : st_ < 0 ? hi >= c0 + 0.75 * m : false
    if r == 0 and sp
        r := -1
    if r >= 0 and t2
        r := 2
    else if r == 0 and t1
        r := 1
    r
int aResBefore = aRes
if not na(aBar) and bar_index >= aFrom and (na(aT1) or time < aT1)
    aRes := score(aRes, aState, aC, aMove, h_, l_)
if array.size(gT0) > 0
    for g = 0 to array.size(gT0) - 1
        if bar_index >= array.get(gFrom, g) and time < array.get(gT1, g)
            array.set(gRes, g, score(array.get(gRes, g), array.get(gState, g), array.get(gC, g), array.get(gMove, g), h_, l_))
int leadEff = math.min(pLead, math.max(1, veH - 2))
bool okBase = bar_index >= 100 and (not timeframe.isintraday or slotNow >= 0)
// (11) the session anchor opens on the first bar of the session where the engine is ready, at the session's open
bool openSess = sessMode and okBase and not sessAnchored and not na(dMove) and dMove > 0 and not na(sessStartMs)
bool openShort = not sessMode and okBase and barstate.isconfirmed and not na(veMoveHNow) and veMoveHNow > 0 and (na(aBar) or (aBar != bar_index and (sessFirst or bar_index >= aBar + aH - leadEff)))
bool openAnchor = openSess or openShort
if openAnchor
    if not na(aBar)
        array.push(gT0, aT0)
        array.push(gT1, aT1)
        array.push(gFrom, aFrom)
        array.push(gC, aC)
        array.push(gMove, aMove)
        array.push(gState, aState)
        array.push(gRes, aRes)
        if array.size(gT0) > 20
            array.shift(gT0)
            array.shift(gT1)
            array.shift(gFrom)
            array.shift(gC)
            array.shift(gMove)
            array.shift(gState)
            array.shift(gRes)
    aBar := bar_index
    if openSess
        aC := dOpen
        aMove := dMove
        aT0 := sessStartMs
        aT1 := sessEndMs
        aFrom := bar_index
        aState := 0
        aSlot := 0
        aTot := totDay
        aH := nSlots - 1
        sessAnchored := true
        aRes := score(0, 0, aC, aMove, h_, l_)
        aCum := cumThrough(slotNow)
    else
        aC := c_
        aMove := veMoveHNow
        aT0 := time
        aT1 := time + (veH + 1) * tfMs
        aFrom := bar_index + 1
        aState := tvState
        aSlot := slotNow
        aTot := veNextH
        aH := veH
        aRes := 0
        aCum := 0.0
    aP1 := veP1
    aP2 := veP2
else if not na(aBar) and bar_index > aBar and (na(aT1) or time < aT1)
    aCum += seasonal ? pf(slotNow) : 1.0
bool fanLive = not na(aBar) and bar_index >= aBar and (na(aT1) or time < aT1)
float aFrac = na(aTot) or aTot <= 0 ? 1.0 : math.min(1.0, aCum / aTot)
float aBand = na(aMove) ? na : aMove * math.sqrt(aFrac)        // the fan's ±1σ at THIS bar (9)
int barsAhead = na(aT1) ? 0 : math.max(0, math.ceil((aT1 - time) / float(tfMs)) - 1)
bool oddsOk = not sessMode and tfMin == 5                       // (5, 32) odds measured on 5m, 24-bar horizon
// (7) exits against the fan that is drawn, first exit of a run only (10), counted since the anchor (14)
bool exitUp = warm and fanLive and c_ > aC + aBand
bool exitDn = warm and fanLive and c_ < aC - aBand
bool exitUpF = exitUp and not exitUp[1]
bool exitDnF = exitDn and not exitDn[1]
var int exUpN = 0
var int exDnN = 0
if openAnchor
    exUpN := 0
    exDnN := 0
if exitUpF
    exUpN += 1
if exitDnF
    exDnN += 1
alertcondition(openAnchor, "مرساة جديدة", "فُتحت مروحة جديدة")
alertcondition(aRes >= 1 and aResBefore < 1, "وصل هدف 1× من المرساة", "السعر لمس هدف 1× للمروحة الحالية")
alertcondition(aRes == 2 and aResBefore < 2, "وصل هدف 2× من المرساة", "السعر لمس هدف 2× للمروحة الحالية")
alertcondition(aRes == -1 and aResBefore != -1, "ضُرب وقف المرساة", "السعر ضرب وقف 0.75× للمروحة الحالية قبل الهدف")
alertcondition(exitUpF or exitDnF, "خروج من المروحة", "إغلاق خارج ±1σ للمروحة الحالية")

// ═══════════════ النافذة: الشموع والأدوات ═══════════════
int winAuto = math.max(60, math.min(400, int(math.ceil(1.5 * sessMin / tfMin))))    // (23) a session and a half
int winN = pWin > 0 ? pWin : (timeframe.isintraday ? winAuto : 150)
bool inWin = bar_index > last_bar_index - winN
int winStartT = time[math.min(bar_index, winN - 1)]
[haO, haH, haL, haC] = request.security(ticker.heikinashi(stdT), timeframe.period, [open, high, low, close], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
bool useHA = pCandleSrc == "هايكن آشي" or (pCandleSrc == "تلقائي" and chart.is_heikinashi)
float dO = useHA ? haO : o_
float dH = useHA ? haH : h_
float dL = useHA ? haL : l_
float dC = useHA ? haC : c_
color candC = dC >= dO ? cUp : cDn
bool rvHot = pRvHi and not na(rvolShow) and rvolShow >= pRvThr
plotcandle(pCandles and inWin ? dO : na, pCandles and inWin ? dH : na, pCandles and inWin ? dL : na, pCandles and inWin ? dC : na, title="الشموع", color=candC, wickcolor=rvHot ? cRvHi : candC, bordercolor=rvHot ? cRvHi : candC, display=display.pane)
plot(pTrail and inWin and warm ? veTrailStop : na, "وقف متحرّك", color=veHit ? cTrHit : tvState > 0 ? cTrUp : cTrDn, style=plot.style_linebr, linewidth=wTrail, display=display.pane)
// (18) arrows sit on the DISPLAYED candles
plotshape(pExits and inWin and exitUpF ? dH + 0.2 * atrV : na, "خروج فوق المروحة", style=shape.triangleup, location=location.absolute, color=cExUp, size=size.tiny, display=display.pane)
plotshape(pExits and inWin and exitDnF ? dL - 0.2 * atrV : na, "خروج تحت المروحة", style=shape.triangledown, location=location.absolute, color=cExDn, size=size.tiny, display=display.pane)
// (22) what the pane's auto-scale includes
float kScale = pScale == "الشموع و±2σ" ? 2.0 : pScale == "الشموع و±1σ" ? 1.0 : 0.0
bool fanOnScale = pFan and inWin and fanLive and kScale > 0
plot(fanOnScale ? aC + kScale * aMove : na, "حدّ المقياس أعلى", color=color.new(cMove, 100), display=display.pane)
plot(fanOnScale ? aC - kScale * aMove : na, "حدّ المقياس أسفل", color=color.new(cMove, 100), display=display.pane)
// data window (37): one entry each
plot(aMove, "حركة المروحة كاملة (1σ)", color=na, display=display.data_window)
plot(aBand, "حدّ المروحة الآن (1σ)", color=na, display=display.data_window)
plot(veMove, "الحركة المتوقّعة لـ 24 شمعة", color=na, display=display.data_window)
plot(rvolShow, "الفوليوم الآن RVOL", color=na, display=display.data_window)
plot(vePct, "حرارة التذبذب", color=na, display=display.data_window)
plot(veRemMove, "المتبقّي حتى الإغلاق", color=na, display=display.data_window)

// ═══════════════ الشريطان: أرضية ثابتة وارتفاع مجمّد معها (15، 27) ═══════════════
int winLen = math.max(1, math.min(winN, bar_index + 1))
float winLo = ta.lowest(l_, winLen)
float winHi = ta.highest(h_, winLen)
// the pane's real vertical extent over the window: candles plus every fan limit that is on the scale, so the strips
// sit under everything visible and their height is a share of what the pane actually shows
float hiS = fanOnScale ? math.max(h_, aC + kScale * aMove) : h_
float loS = fanOnScale ? math.min(l_, aC - kScale * aMove) : l_
float winHiS = ta.highest(hiS, winLen)
float winLoS = ta.lowest(loS, winLen)
float paneSpan = math.max(winHiS - winLoS, 4 * atrV)
float sBase = math.min(winLoS, pDay and not na(veDayLo) ? veDayLo : winLoS)
var float sFloor = na
var float sHv = na
var float sHq = na
var float sGapV = na
var float sRange = na
if pStrips and not na(sBase)
    if na(sFloor) or sessFirst or sBase < sFloor + 0.5 * nz(sGapV) or math.abs(paneSpan - nz(sRange, paneSpan)) > 0.10 * nz(sRange, paneSpan)
        sGapV := pStripGap / 100 * paneSpan
        sHv := pHeatS ? pHeatH / 100 * paneSpan : 0.0
        sHq := pSqzS ? pSqzH / 100 * paneSpan : 0.0
        sFloor := sBase - sGapV
        sRange := paneSpan
float sqzTop = pHeatS ? sFloor - 0.3 * sHv : sFloor + sHv
heatOf(float p, bool sq) => sq ? cSqzOn : na(p) ? cHeatNA : p < 50 ? color.from_gradient(p, 0, 50, cHeat0, cHeat50) : color.from_gradient(p, 50, 100, cHeat50, cHeat100)
var box[] stripHeat = array.new_box()
var box[] stripSqz = array.new_box()
int stride = winN > 200 ? 2 : 1
int stripN = math.ceil(winN / float(stride))
var float sFloorSet = na
if pStrips and barstate.isconfirmed and not na(sFloor) and bar_index % stride == 0
    array.push(stripHeat, box.new(bar_index, sFloor + sHv, bar_index + stride, sFloor, border_color=color.new(cNorm, 100), bgcolor=pHeatS ? heatOf(vePct, veSqzOn) : color.new(cHeatNA, 100)))
    array.push(stripSqz, box.new(bar_index, sqzTop, bar_index + stride, sqzTop - sHq, border_color=color.new(cSqzOn, 100), bgcolor=not pSqzS ? color.new(cSqzOff, 100) : veSqzOn ? cSqzOn : cSqzOff))
    while array.size(stripHeat) > stripN
        box.delete(array.shift(stripHeat))
        box.delete(array.shift(stripSqz))
if pStrips and not na(sFloor) and (na(sFloorSet) or sFloor != sFloorSet)
    for bx in stripHeat
        box.set_top(bx, sFloor + sHv)
        box.set_bottom(bx, sFloor)
    for bx in stripSqz
        box.set_top(bx, sqzTop)
        box.set_bottom(bx, sqzTop - sHq)
    sFloorSet := sFloor
// (20) the live bar shows the last CONFIRMED heat / squeeze, so it does not flicker inside the bar
float heatLive = barstate.isrealtime ? vePct[1] : vePct
bool sqzLive = barstate.isrealtime ? veSqzOn[1] : veSqzOn
var box liveHeat = na
var box liveSqz = na
if pStrips and barstate.islast and not na(sFloor)
    box.delete(liveHeat)
    box.delete(liveSqz)
    liveHeat := box.new(bar_index, sFloor + sHv, bar_index + stride, sFloor, border_color=color.new(cNorm, 100), bgcolor=pHeatS ? heatOf(heatLive, sqzLive) : color.new(cHeatNA, 100))
    liveSqz := box.new(bar_index, sqzTop, bar_index + stride, sqzTop - sHq, border_color=color.new(cSqzOn, 100), bgcolor=not pSqzS ? color.new(cSqzOff, 100) : sqzLive ? cSqzOn : cSqzOff)
plot(pStrips and inWin ? sqzTop - sHq - 0.3 * math.max(sHv, sHq) : na, "قاع الشريطين", color=color.new(cSqzOff, 85), linewidth=1, display=display.pane)

// ═══════════════ الرسم على آخر شمعة ═══════════════
var line[] fLines = array.new_line()
var box[] fBoxes = array.new_box()
var label[] fLabels = array.new_label()
var polyline[] fPolys = array.new<polyline>()
resTxt(int r) => r == 2 ? "✓ 2×" : r == 1 ? "✓ 1×" : r == -1 ? "✗" : "—"
var label sLb1 = na
var label sLb2 = na
if barstate.islast
    for ln in fLines
        line.delete(ln)
    for bx in fBoxes
        box.delete(bx)
    for lb in fLabels
        label.delete(lb)
    for pl in fPolys
        polyline.delete(pl)
    array.clear(fLines)
    array.clear(fBoxes)
    array.clear(fLabels)
    array.clear(fPolys)
    // (4) the purple range of EVERY session in the window, each from its open to its close
    if pDay and timeframe.isintraday and warm and array.size(dT0) > 0
        for k = 0 to array.size(dT0) - 1
            int t0 = array.get(dT0, k)
            int t1 = array.get(dT1, k)
            if not na(t1) and t1 > winStartT and (pDayPast or k == array.size(dT0) - 1)
                array.push(fLines, line.new(t0, array.get(dHi, k), t1, array.get(dHi, k), xloc=xloc.bar_time, color=cDayL, style=stOf(sDay), width=wDay))
                array.push(fLines, line.new(t0, array.get(dLo, k), t1, array.get(dLo, k), xloc=xloc.bar_time, color=cDayL, style=stOf(sDay), width=wDay))
        int kl = array.size(dT0) - 1
        if pDayLbl
            array.push(fLabels, label.new(array.get(dT0, kl), array.get(dHi, kl), "أعلى اليوم المتوقّع", xloc=xloc.bar_time, style=label.style_label_lower_right, color=color.new(cDayL, 100), textcolor=color.new(cDayL, 0), size=szDay))
            array.push(fLabels, label.new(array.get(dT0, kl), array.get(dLo, kl), "أدنى اليوم المتوقّع", xloc=xloc.bar_time, style=label.style_label_upper_right, color=color.new(cDayL, 100), textcolor=color.new(cDayL, 0), size=szDay))
    if not na(aBar) and not na(aT1)
        int sideA = aState == 0 ? 1 : aState
        float y1 = aC + sideA * aMove
        float y2 = aC + sideA * 2 * aMove
        float yS = aC - sideA * 0.75 * aMove
        if pFan
            if pBox2
                array.push(fBoxes, box.new(aT0, aC + 2 * aMove, aT1, aC - 2 * aMove, xloc=xloc.bar_time, border_color=cBox2B, bgcolor=cBox2))
            if pBox1
                array.push(fBoxes, box.new(aT0, aC + aMove, aT1, aC - aMove, xloc=xloc.bar_time, border_color=cBox1B, bgcolor=cBox1))
            // (9) the fan as a curve: ±kσ × sqrt(the share of the horizon's seasonal variance that has passed)
            int nP = math.max(1, aH + 1)
            int stepP = math.max(1, int(math.ceil(nP / 80.0)))
            for m = 1 to 2
                for sgn = -1 to 1 by 2
                    pts = array.new<chart.point>()
                    array.push(pts, chart.point.from_time(aT0, aC))
                    float run = 0.0
                    for j = 0 to nP - 1
                        int sl = sessMode ? j : (aSlot + 1 + j) % math.max(1, nSlots)
                        run := sessMode ? cumThrough(j) : run + (seasonal ? pf(sl) : 1.0)
                        if j % stepP == 0 or j == nP - 1
                            float fr = na(aTot) or aTot <= 0 ? 1.0 : math.min(1.0, run / aTot)
                            int tj = sessMode ? aT0 + (j + 1) * tfMs : aT0 + (j + 1) * tfMs
                            array.push(pts, chart.point.from_time(math.min(tj, aT1), aC + sgn * m * aMove * math.sqrt(fr)))
                    if m == 1 ? pCv1 : pCv2
                        array.push(fPolys, polyline.new(pts, curved=true, xloc=xloc.bar_time, line_color=m == 1 ? cCv1 : cCv2, line_style=stOf(m == 1 ? sCv1 : sCv2), line_width=m == 1 ? wCv1 : wCv2))
            if pOpenLn
                array.push(fLines, line.new(aT0, aC, aT1, aC, xloc=xloc.bar_time, color=cOpenLn, width=wOpenLn, style=stOf(sOpenLn)))
            // (17) one plain anchor label on the anchor's own time
            if pOpenLbl
                array.push(fLabels, label.new(aT0, aC, (sessMode ? "افتتاح " : "المرساة ") + str.tostring(aC, format.mintick) + " · " + str.format_time(aT0, "HH:mm", syminfo.timezone), xloc=xloc.bar_time, style=label.style_label_right, color=cOpenBg, textcolor=cOpenTx, size=szOpen))
        if pLadder
            if sessMode or aState == 0
                // symmetric: both ±1σ and ±2σ are reference targets, no fixed stop (13, 15)
                for m = 1 to 2
                    for sgn = -1 to 1 by 2
                        float yy = aC + sgn * m * aMove
                        if m == 1 ? pT1 : pT2
                            array.push(fLines, line.new(aT0, yy, aT1, yy, xloc=xloc.bar_time, color=m == 1 ? cT1 : cT2, width=m == 1 ? wT1 : wT2, style=stOf(m == 1 ? sT1 : sT2)))
                        if m == 1 ? pT1Lbl : pT2Lbl
                            array.push(fLabels, label.new(aT1, yy, (sgn > 0 ? "+" : "−") + str.tostring(m) + "σ  " + str.tostring(yy, format.mintick), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(cT1, 100), textcolor=color.new(m == 1 ? cT1 : cT2, 0), size=m == 1 ? szT1 : szT2))
            else
                string o1 = oddsOk ? " · " + aP1 + (aP1 != "25%" ? " (قوة الاتجاه)" : "") : ""
                string o2 = oddsOk ? " · " + aP2 : ""
                if pT1
                    array.push(fLines, line.new(aT0, y1, aT1, y1, xloc=xloc.bar_time, color=cT1, width=wT1, style=stOf(sT1)))
                if pT2
                    array.push(fLines, line.new(aT0, y2, aT1, y2, xloc=xloc.bar_time, color=cT2, width=wT2, style=stOf(sT2)))
                if pStop
                    array.push(fLines, line.new(aT0, yS, aT1, yS, xloc=xloc.bar_time, color=cStop, width=wStop, style=stOf(sStop)))
                if pT1Lbl
                    array.push(fLabels, label.new(aT1, y1, "هدف 1×  " + str.tostring(y1, format.mintick) + o1, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(cT1, 100), textcolor=color.new(cT1, 0), size=szT1))
                if pT2Lbl
                    array.push(fLabels, label.new(aT1, y2, "هدف 2×  " + str.tostring(y2, format.mintick) + o2, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(cT2, 100), textcolor=color.new(cT2, 0), size=szT2))
                if pStopLbl
                    array.push(fLabels, label.new(aT1, yS, "وقف 0.75×  " + str.tostring(yS, format.mintick) + (oddsOk ? " · يُضرب 5%" : ""), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(cStop, 100), textcolor=color.new(cStop, 0), size=szStop))
    // (3) the remaining move to the close, around the CURRENT price
    if pRem and not na(veRemMove) and veRemMove >= 2 * syminfo.mintick and not na(sessEndMs) and time < sessEndMs
        array.push(fLines, line.new(time, c_ + veRemMove, sessEndMs, c_ + veRemMove, xloc=xloc.bar_time, color=cRem, width=wRem, style=stOf(sRem)))
        array.push(fLines, line.new(time, c_ - veRemMove, sessEndMs, c_ - veRemMove, xloc=xloc.bar_time, color=cRem, width=wRem, style=stOf(sRem)))
        if pRemLbl
            array.push(fLabels, label.new(sessEndMs, c_ - veRemMove, "حتى الإغلاق ±" + str.tostring(veRemMove, format.mintick), xloc=xloc.bar_time, style=label.style_label_up, color=color.new(cRem, 100), textcolor=color.new(cRem, 0), size=szRem))
    if pTrail and pTrLbl and warm and not na(veTrailStop)
        array.push(fLabels, label.new(bar_index + 1, veTrailStop, "وقف متحرّك" + (veHit ? " · ضُرب" : ""), style=label.style_label_left, color=color.new(cTrUp, 100), textcolor=color.new(veHit ? cTrHit : tvState > 0 ? cTrUp : cTrDn, 0), size=szTr))
    // ghosts inside the window, with the box-budget guard (32)
    int nG = array.size(gT0)
    int boxesUsed = array.size(stripHeat) + array.size(stripSqz) + array.size(fBoxes) + 2
    int ghostCap = math.max(0, math.min(pGhost, math.floor((480 - boxesUsed) / 2.0)))
    if nG > 0 and ghostCap > 0
        for g = math.max(0, nG - ghostCap) to nG - 1
            int g0t = array.get(gT0, g)
            int g1t = array.get(gT1, g)
            if g1t > winStartT
                float gc = array.get(gC, g)
                float gm = array.get(gMove, g)
                int gr = array.get(gRes, g)
                int gs = array.get(gState, g)
                array.push(fBoxes, box.new(g0t, gc + 2 * gm, g1t, gc - 2 * gm, xloc=xloc.bar_time, border_color=color.new(cGh, math.min(100, color.t(cGh) + 5)), bgcolor=color.new(cGh, 100)))
                array.push(fBoxes, box.new(g0t, gc + gm, g1t, gc - gm, xloc=xloc.bar_time, border_color=cGh, bgcolor=color.new(cGh, 100)))
                array.push(fLines, line.new(g0t, gc, g1t, gc, xloc=xloc.bar_time, color=color.new(cOpenLn, 60), width=1, style=line.style_dotted))
                if gs != 0
                    array.push(fLines, line.new(g0t, gc + gs * gm, g1t, gc + gs * gm, xloc=xloc.bar_time, color=color.new(cT1, 75), width=1, style=stOf(sT1)))
                    array.push(fLines, line.new(g0t, gc - gs * 0.75 * gm, g1t, gc - gs * 0.75 * gm, xloc=xloc.bar_time, color=color.new(cStop, 75), width=1, style=stOf(sStop)))
                if pGhLbl
                    array.push(fLabels, label.new(g1t, gc, resTxt(gr) + (time < g1t ? " …" : ""), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(cGhNone, 100), textcolor=gr > 0 ? cGhWin : gr < 0 ? cGhLoss : cGhNone, size=szGh))
    // strip titles at the left of the window, above and below the strips
    if pStrips and not na(sFloor)
        label.delete(sLb1)
        label.delete(sLb2)
        // titles at the current session's start (plus a tenth of it), which is always in view
        int xw0 = na(sessStartMs) ? time : sessStartMs + int(0.1 * sessMin * 60000)
        string heatTxt = na(vePct) ? "حرارة التذبذب: بيانات غير كافية (" + str.tostring(veHeatN) + "/10 جلسات)" : "حرارة التذبذب حسب وقت اليوم: الآن " + str.tostring(vePct, "#") + "%" + (veAccel ? " ↑ تتسارع" : "")
        if pHeatS and pHeatLbl
            sLb1 := label.new(xw0, sFloor + sHv, heatTxt, xloc=xloc.bar_time, style=label.style_label_lower_left, color=color.new(cPanel, 20), textcolor=cHeatTx, size=szHeat)
        if pSqzS and pSqzLbl
            sLb2 := label.new(xw0, sqzTop - sHq, "الانضغاط" + (veSqzOn ? ": نعم منذ " + str.tostring(veSqzBars) + " شمعة · اصبر" : " (بنفسجي عند حدوثه)"), xloc=xloc.bar_time, style=label.style_label_upper_left, color=color.new(cPanel, 20), textcolor=cSqzTx, size=szSqz)

// ═══════════════ مربّع «الحالة الآن» ═══════════════
bPos = pBoxPos == "وسط اليمين" ? position.middle_right : pBoxPos == "أعلى اليمين" ? position.top_right : pBoxPos == "أسفل اليمين" ? position.bottom_right : pBoxPos == "وسط اليسار" ? position.middle_left : pBoxPos == "أسفل اليسار" ? position.bottom_left : position.top_left
var table sb = table.new(bPos, 2, 16, bgcolor=color.new(cPanel, pTblAlpha), border_color=cFrame, border_width=1, frame_color=cFrame, frame_width=1)
if pBox and barstate.islast
    table.clear(sb, 0, 0, 1, 15)
    string dirW = tvState > 0 ? "صاعد" : tvState < 0 ? "هابط" : "لا اتجاه"
    color dirC = tvState > 0 ? cUp : tvState < 0 ? cDn : cDim
    bool hot = not na(vePct) and vePct >= 80
    // (13) the advice matches what is drawn: no trend = no fixed stop
    string verdict = tvState != 0 and veHit ? "الاتجاه " + dirW + "، لكنّ وقفه المتحرّك ضُرب:\nلا صفقة جديدة حتى حالة جديدة" : tvState != 0 ? "الاتجاه " + dirW + ":\nالصفقات معه فقط\nالوقف المتحرّك " + str.tostring(veTrailStop, format.mintick) : "لا اتجاه:\nلا وقف ثابت؛ ±1σ و±2σ مرجع للمدى فقط"
    if hot
        verdict += "\nاليوم ساخن: صغّر الحجم"
    if veSqzOn
        verdict += "\nانضغاط: اصبر"
    float aSig = na(aBand) or aBand == 0 ? na : (c_ - aC) / aBand
    string aDist = na(aC) ? "-" : (c_ >= aC ? "+" : "−") + str.tostring(math.abs(c_ - aC), format.mintick) + " (" + (aSig >= 0 ? "+" : "−") + str.tostring(math.abs(nz(aSig)), "#.0") + "σ الآن)"
    string rvTxt = noVol ? "لا حجم لهذا الرمز" : na(rvolShow) ? "بيانات غير كافية" : str.tostring(rvolShow, "#.0") + "× " + (rvolShow >= 2 ? "عالٍ جدًا" : rvolShow >= 1.2 ? "قوي" : "عادي")
    string heatCell = na(vePct) ? "بيانات غير كافية (" + str.tostring(veHeatN) + "/10)" : str.tostring(vePct, "#") + "%" + (vePct >= 80 ? " ساخن" : vePct < 20 ? " بارد" : "") + (veAccel ? " ↑ تتسارع" : "")
    string mvTxt = na(aMove) ? "-" : "±" + str.tostring(aMove, format.mintick) + " (" + str.tostring(100 * aMove / aC, "#.00") + "%) · " + (sessMode ? "اليوم" : str.tostring(aH) + " شمعة")
    string tgTxt = na(aMove) ? "-" : sessMode or aState == 0 ? "±1σ " + str.tostring(aC + aMove, format.mintick) + " / " + str.tostring(aC - aMove, format.mintick) : "1× " + str.tostring(aC + aState * aMove, format.mintick) + " · 2× " + str.tostring(aC + aState * 2 * aMove, format.mintick) + (oddsOk ? " · " + aP1 + " / " + aP2 : "")
    string trTxt = na(veTrailStop) ? "لا اتجاه" : str.tostring(veTrailStop, format.mintick) + (veHit ? " · ضُرب" : "")
    string exTxt = str.tostring(exDnN) + "▼  " + str.tostring(exUpN) + "▲  منذ المرساة"
    bool tfWarn = tfMin != 5 and tfMin != 15
    if pCompact
        table.cell(sb, 1, 0, "الآن " + str.format_time(time, "HH:mm", syminfo.timezone) + " · " + dirW, text_color=dirC, text_size=tszH, text_halign=text.align_right)
        table.cell(sb, 0, 0, "", text_size=tsz)
        table.merge_cells(sb, 0, 0, 1, 0)
        table.cell(sb, 1, 1, "الحركة", text_color=cDim, text_size=tsz, text_halign=text.align_right)
        table.cell(sb, 0, 1, mvTxt, text_color=cMove, text_size=tsz, text_halign=text.align_right)
        table.cell(sb, 1, 2, "الأهداف", text_color=cDim, text_size=tsz, text_halign=text.align_right)
        table.cell(sb, 0, 2, tgTxt, text_color=cTgt, text_size=tsz, text_halign=text.align_right)
        table.cell(sb, 1, 3, "متحرّك", text_color=cDim, text_size=tsz, text_halign=text.align_right)
        table.cell(sb, 0, 3, trTxt + (noVol ? "" : " · فوليوم " + rvTxt), text_color=color.new(veHit ? cTrHit : tvState < 0 ? cTrDn : cTrUp, 0), text_size=tsz, text_halign=text.align_right)
        table.cell(sb, 1, 4, "حرارة · خروج", text_color=cDim, text_size=tsz, text_halign=text.align_right)
        table.cell(sb, 0, 4, heatCell + " · " + (veSqzOn ? "انضغاط " + str.tostring(veSqzBars) : "لا انضغاط") + " · " + exTxt, text_color=cHot, text_size=tsz, text_halign=text.align_right)
        table.cell(sb, 0, 5, verdict, text_color=cVerdict, text_size=tsz, text_halign=text.align_right)
        table.merge_cells(sb, 0, 5, 1, 5)
    else
        table.cell(sb, 1, 0, "الحالة الآن " + str.format_time(time, "HH:mm", syminfo.timezone), text_color=cTxt, text_size=tszH, text_halign=text.align_right)
        table.cell(sb, 0, 0, "", text_size=tsz)
        table.merge_cells(sb, 0, 0, 1, 0)
        int r = 1
        if rDir
            table.cell(sb, 1, r, "الاتجاه", text_color=cDim, text_size=tsz, text_halign=text.align_right)
            table.cell(sb, 0, r, dirW, text_color=dirC, text_size=tsz, text_halign=text.align_right)
            r += 1
        if rMove
            table.cell(sb, 1, r, "الحركة", text_color=cDim, text_size=tsz, text_halign=text.align_right)
            table.cell(sb, 0, r, mvTxt, text_color=cMove, text_size=tsz, text_halign=text.align_right)
            r += 1
        if rTgt
            table.cell(sb, 1, r, "الأهداف", text_color=cDim, text_size=tsz, text_halign=text.align_right)
            table.cell(sb, 0, r, tgTxt, text_color=cTgt, text_size=tsz, text_halign=text.align_right)
            r += 1
        if rTgt2 and (sessMode or aState == 0) and not na(aMove)
            table.cell(sb, 1, r, "±2σ", text_color=cDim, text_size=tsz, text_halign=text.align_right)
            table.cell(sb, 0, r, str.tostring(aC + 2 * aMove, format.mintick) + " / " + str.tostring(aC - 2 * aMove, format.mintick), text_color=color.new(cT2, 0), text_size=tsz, text_halign=text.align_right)
            r += 1
        else if rTgt2 and not na(aMove)
            table.cell(sb, 1, r, "الوقف الثابت", text_color=cDim, text_size=tsz, text_halign=text.align_right)
            table.cell(sb, 0, r, str.tostring(aC - aState * 0.75 * aMove, format.mintick) + " (0.75×)", text_color=color.new(cStop, 0), text_size=tsz, text_halign=text.align_right)
            r += 1
        if rTr
            table.cell(sb, 1, r, "الوقف المتحرّك", text_color=cDim, text_size=tsz, text_halign=text.align_right)
            table.cell(sb, 0, r, trTxt, text_color=color.new(veHit ? cTrHit : tvState > 0 ? cTrUp : tvState < 0 ? cTrDn : cDim, 0), text_size=tsz, text_halign=text.align_right)
            r += 1
        if rVol and not noVol                                                                  // (28)
            table.cell(sb, 1, r, "الفوليوم الآن", text_color=cDim, text_size=tsz, text_halign=text.align_right)
            table.cell(sb, 0, r, rvTxt, text_color=na(rvolShow) ? cDim : rvolShow >= pRvThr ? cRvHi : rvolShow >= 1.2 ? cUp : cTxt, text_size=tsz, text_halign=text.align_right)
            r += 1
        if rRem and not na(veRemMove)
            table.cell(sb, 1, r, "حتى الإغلاق", text_color=cDim, text_size=tsz, text_halign=text.align_right)
            table.cell(sb, 0, r, "±" + str.tostring(veRemMove, format.mintick), text_color=color.new(cRem, 0), text_size=tsz, text_halign=text.align_right)
            r += 1
        if rHeat
            table.cell(sb, 1, r, "الحرارة", text_color=cDim, text_size=tsz, text_halign=text.align_right)
            table.cell(sb, 0, r, heatCell, text_color=na(vePct) ? cDim : cHeatTx, text_size=tsz, text_halign=text.align_right)
            r += 1
        if rSqz
            table.cell(sb, 1, r, "الانضغاط", text_color=cDim, text_size=tsz, text_halign=text.align_right)
            table.cell(sb, 0, r, veSqzOn ? "نعم منذ " + str.tostring(veSqzBars) + " شمعة" + (veLunch ? " (غداء)" : "") : (veComp[1] < veThr ? "خرج: ليس بداية حركة" : "لا"), text_color=cSqzTx, text_size=tsz, text_halign=text.align_right)
            r += 1
        if rExit
            table.cell(sb, 1, r, "الخروج", text_color=cDim, text_size=tsz, text_halign=text.align_right)
            table.cell(sb, 0, r, exTxt, text_color=exDnN > exUpN ? cExDn : exUpN > exDnN ? cExUp : cDim, text_size=tsz, text_halign=text.align_right)
            r += 1
        if rDist
            table.cell(sb, 1, r, "من المرساة", text_color=cDim, text_size=tsz, text_halign=text.align_right)
            table.cell(sb, 0, r, aDist + " · باقٍ " + str.tostring(barsAhead), text_color=nz(aSig) >= 0 ? cUp : cDn, text_size=tsz, text_halign=text.align_right)
            r += 1
        if rWarn and tfWarn                                                                    // (30–32)
            table.cell(sb, 0, r, "⚠ الانضغاط والاتجاه مقيسان على 5د و15د", text_color=cDim, text_size=tsz, text_halign=text.align_right)
            table.merge_cells(sb, 0, r, 1, r)
            r += 1
        if rVerd
            table.cell(sb, 0, r, verdict, text_color=cVerdict, text_size=tsz, text_halign=text.align_right)
            table.merge_cells(sb, 0, r, 1, r)
alertcondition(veSqzOn and not veSqzOn[1], "انضغاط", "دخل السعر في انضغاط (ATR14/ATR100 تحت عُشره المعتاد)")
alertcondition(not na(rvol) and rvol >= 2, "فوليوم عالٍ جدًا", "RVOL ≥ 2× لنفس الدقيقة")
alertcondition(veHit and not veHit[1], "ضُرب الوقف المتحرّك", "الإغلاق عبر الوقف المتحرّك للاتجاه الحالي")

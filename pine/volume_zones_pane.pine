// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © options-agent — Volume Zones · لوحة: نافذة مرافقة تحت الشموع (reports/vol_engine, reports/vol_engine_dev, 2026-10-25)
//@version=6
indicator("Volume Zones · لوحة", "VZ لوحة", overlay=false, format=format.price, precision=2, max_boxes_count=500, max_lines_count=100, max_labels_count=100)

// ═══════════════ المدخلات ═══════════════
G_P = "اللوحة"
pMode = input.string("النافذة الكاملة (الشموع والأدوات)", "محتوى النافذة", options=["النافذة الكاملة (الشموع والأدوات)", "ثلاثة أجزاء في نافذة واحدة", "الكلّ في نافذة واحدة", "الفوليوم الآن فقط", "الحركة المتوقّعة والانضغاط فقط", "شريط الحرارة فقط"], tooltip="النافذة الكاملة: نفس شموع الشارت مع المروحة الموسمية والسلّم ومدى اليوم والمتبقّي حتى الإغلاق والوقف المتحرّك وأسهم الخروج، وتحت الرسم شريط الحرارة ثمّ الانضغاط، ومربّع «الحالة الآن» على اليمين. الأوضاع الأخرى كما في الإصدارات السابقة", group=G_P)
G_F = "النافذة الكاملة"
pFan    = input.bool(true, "المروحة الموسمية ±1σ و±2σ", group=G_F)
pLadder = input.bool(true, "سلّم الوقف والهدف", group=G_F)
pDay    = input.bool(true, "خطّا مدى اليوم", group=G_F)
pRem    = input.bool(true, "المتبقّي حتى الإغلاق (5 دقائق)", group=G_F)
pTrail  = input.bool(true, "وقف متحرّك للاتجاه الحالي", group=G_F)
pExits  = input.bool(true, "أسهم الخروج من النطاق ▲▼", group=G_F)
pStrips = input.bool(true, "شريطا الحرارة والانضغاط تحت الرسم", group=G_F)
pStripN = input.int(150, "طول الشريطين (شموع)", minval=30, maxval=400, group=G_F)
pBox    = input.bool(true, "مربّع «الحالة الآن»", group=G_F)
pBoxPos = input.string("وسط اليمين", "موقع المربّع", options=["وسط اليمين", "أعلى اليمين", "أسفل اليمين", "أعلى اليسار"], group=G_F)
G_O = "الأوضاع الأخرى"
pRvol  = input.bool(true, "أعمدة الفوليوم الآن (RVOL)", tooltip="حجم الشمعة ÷ وسيط حجم نفس الدقيقة في آخر 20 جلسة. يتنبّأ باتّساع المدى (IC 0.28) لا بالاتجاه", group=G_O)
pMove  = input.bool(true, "خطّ الحركة المتوقّعة", group=G_O)
pMoveX = input.float(10, "مضاعف عرض الحركة المتوقّعة", minval=1, maxval=100, step=1, group=G_O)
pSqz   = input.bool(true, "تظليل الانضغاط", group=G_O)
pHeat  = input.bool(true, "شريط حرارة التذبذب", tooltip="لون كل شمعة = ترتيب الحركة المتوقّعة مقابل نفس وقت اليوم في آخر 20 جلسة. مقيس: يتنبّأ باتّساع المدى (ic 0.15) بينما الترتيب على 500 شمعة لا (−0.04)", group=G_O)
pTbl   = input.bool(true, "جدول الأرقام", group=G_O)
pTblPos = input.string("أعلى اليمين", "موقع الجدول", options=["أعلى اليمين", "أسفل اليمين", "أعلى اليسار", "أسفل اليسار"], group=G_O)
G_C = "الألوان"
cUp   = input.color(#26a69a, "صعود", inline="pc", group=G_C)
cDn   = input.color(#ef5350, "هبوط", inline="pc", group=G_C)
cHot  = input.color(#ffd600, "عالٍ جدًا", inline="pc", group=G_C)
cNorm = input.color(#5d606b, "عادي", inline="pc", group=G_C)
cMove = input.color(#29b6f6, "المروحة", inline="pc2", group=G_C)
cSqz  = input.color(#ab47bc, "الانضغاط", inline="pc2", group=G_C)
cDay  = input.color(#b388ff, "مدى اليوم", inline="pc2", group=G_C)
cTgt  = input.color(#c6ff00, "الأهداف", inline="pc3", group=G_C)
cTrail = input.color(#ff7043, "الوقف المتحرّك", inline="pc3", group=G_C)

// ═══════════════ الشموع الحقيقية (نفس قاعدة المؤشّر الرئيسي) ═══════════════
stdT0 = ticker.standard(syminfo.tickerid)
stdT = str.contains(syminfo.tickerid, "dividends") ? ticker.modify(stdT0, syminfo.session, adjustment.dividends) : stdT0
[o_, h_, l_, c_] = request.security(stdT, timeframe.period, [open, high, low, close], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
trR = na(c_[1]) ? h_ - l_ : math.max(h_ - l_, math.max(math.abs(h_ - c_[1]), math.abs(l_ - c_[1])))
atrV = ta.rma(trR, 14)
bool newSess = ta.change(time("D")) != 0

// ═══════════════ RVOL حسب وقت اليوم ═══════════════
int tfMin   = timeframe.isintraday ? (timeframe.isseconds ? 1 : timeframe.multiplier) : 390
int nSlots  = timeframe.isintraday ? math.max(1, math.ceil(390.0 / tfMin)) : 1
int minsIn  = hour(time, syminfo.timezone) * 60 + minute(time, syminfo.timezone) - 570
int slotNow = timeframe.isintraday ? (minsIn < 0 or minsIn >= 390 ? -1 : math.min(nSlots - 1, math.floor(minsIn / tfMin))) : 0
var matrix<float> rvBuf = matrix.new<float>(nSlots, 20, na)
float rvBase = na
if slotNow >= 0
    rvVals = array.new_float()
    for j = 0 to 19
        rvx = matrix.get(rvBuf, slotNow, j)
        if not na(rvx)
            array.push(rvVals, rvx)
    if array.size(rvVals) >= 10
        rvBase := array.median(rvVals)
float rvol = na(rvBase) or rvBase <= 0 ? na : volume / rvBase
if barstate.isconfirmed and slotNow >= 0
    for j = 0 to 18
        matrix.set(rvBuf, slotNow, j, matrix.get(rvBuf, slotNow, j + 1))
    matrix.set(rvBuf, slotNow, 19, volume)


// ═══════════════ نموذج الاتجاه (الحالة وقوّتها فقط؛ نفس معادلات المؤشّر الرئيسي) ═══════════════
int tvmLen = tfMin <= 5 ? 67 : tfMin <= 15 ? 66 : 56
tvM  = ta.hma(c_, tvmLen)
tvSl = tvM - tvM[1]
int tvState = c_ > tvM and tvSl > 0 and tvSl[1] > 0 and tvSl[2] > 0 ? 1 : c_ < tvM and tvSl < 0 and tvSl[1] < 0 and tvSl[2] < 0 ? -1 : 0
tvPath = math.sum(math.abs(ta.change(c_)), 20)
float tvI = tvPath > 0 ? math.abs(c_ - c_[20]) / tvPath : 0.0
float tvJ0 = math.sum((c_ - o_) / atrV, 10)
float tvS0 = 0.5 * tvI + 0.5 * math.min(1.0, math.abs(tvJ0) / 3.0)

// ═══════════════ محرّك التذبذب v2 (نفس معادلات المؤشّر الرئيسي الإصدار 50) ═══════════════
float veR = newSess or na(c_[1]) ? math.log(c_ / o_) : math.log(c_ / c_[1])
float veLam = tfMin <= 5 ? 0.99 : timeframe.isdwm ? 0.94 : 0.97
var float veS2 = na
veS2 := na(veS2) ? veR * veR : veLam * veS2 + (1 - veLam) * veR * veR
int veK = tfMin <= 5 ? 24 : tfMin <= 15 ? 8 : tfMin <= 60 ? 2 : 5
var float[] veProf5 = array.from(13.0616, 4.8267, 3.6186, 3.5973, 2.9083, 2.2205, 2.5626, 1.8878, 1.6552, 1.5478, 1.5150, 1.3400, 1.3999, 1.3048, 1.1005, 1.0198, 1.0875, 0.9432, 0.9621, 0.9115, 0.8946, 0.7789, 0.8649, 0.7575, 0.7734, 0.7263, 0.6908, 0.6309, 0.6126, 0.5490, 0.6428, 0.5213, 0.5306, 0.5239, 0.5307, 0.4423, 0.5344, 0.4355, 0.4537, 0.4399, 0.4756, 0.4301, 0.4941, 0.3874, 0.4243, 0.4877, 0.4332, 0.4195, 0.4622, 0.4479, 0.3848, 0.3877, 0.3981, 0.3667, 0.5075, 0.4125, 0.3680, 0.3705, 0.3549, 0.3387, 0.4077, 0.3518, 0.3282, 0.2971, 0.3384, 0.3667, 0.4148, 0.4013, 0.3611, 0.3712, 0.3645, 0.3211, 0.4269, 0.3818, 0.4306, 0.4423, 0.9771, 0.8611)
var float[] veG5 = array.from(7.830, 7.297, 6.952, 6.700, 6.509, 6.301, 5.940, 5.879, 5.761, 5.646, 5.554, 5.505, 5.380, 5.218, 5.228, 5.100, 5.001, 4.960, 4.825, 4.775, 4.668, 4.679, 4.566, 4.549, 4.489, 4.436, 4.442, 4.389, 4.335, 4.314, 4.275, 4.245, 4.210, 4.128, 4.122, 4.119, 4.023, 3.989, 3.910, 3.874, 3.801, 3.785, 3.708, 3.711, 3.771, 3.747, 3.678, 3.618, 3.554, 3.465, 3.425, 3.409, 3.370, 3.317, 3.252, 3.197, 3.157, 3.115, 3.049, 2.952, 2.930, 2.891, 2.795, 2.728, 2.635, 2.599, 2.439, 2.364, 2.290, 2.197, 2.096, 2.037, 1.909, 1.821, 1.667, 1.462, 0.980, 0.000)
var float[] veProf = array.new_float()
if barstate.isfirst and timeframe.isintraday
    for j = 0 to nSlots - 1
        int lo5 = math.floor(j * tfMin / 5.0)
        int hi5 = math.max(lo5, math.floor((j + 1) * tfMin / 5.0) - 1)
        float sF = 0.0
        int nF = 0
        for q = lo5 to hi5
            if q < 78
                sF += array.get(veProf5, q)
                nF += 1
        array.push(veProf, nF > 0 ? sF / nF : 1.0)
float veF = timeframe.isintraday and slotNow >= 0 and array.size(veProf) > slotNow ? array.get(veProf, slotNow) : 1.0
var float veS2d = na
veS2d := na(veS2d) ? veR * veR / veF : veLam * veS2d + (1 - veLam) * veR * veR / veF
float veNext = veK
if timeframe.isintraday and slotNow >= 0 and array.size(veProf) > 0
    float sN = 0.0
    for q = 1 to veK
        sN += array.get(veProf, (slotNow + q) % array.size(veProf))
    veNext := sN
float veS2k = timeframe.isintraday ? veS2d * veNext : veK * veS2
float veMove = timeframe.isdwm ? math.sqrt(2.701088) * atrV * math.sqrt(veK / 5.0) : math.sqrt(veS2k) * c_
float veMovePct = 100 * veMove / c_
float veA100 = ta.rma(trR, 100)
float veComp = veA100 > 0 ? atrV / veA100 : na
float veThr = timeframe.isdwm ? 0.8833 : 0.6967
bool veSqzOn = veComp < veThr
var int veSqzBars = 0
veSqzBars := veSqzOn ? veSqzBars + 1 : 0
bool veLunch = minsIn >= 150 and minsIn < 240
// heat: rank against the same slot of the previous 20 sessions
var matrix<float> veHBuf = matrix.new<float>(nSlots, 20, na)
float vePct = na
if slotNow >= 0 and not na(veMove)
    int veBelow = 0
    int veCnt = 0
    for j = 0 to 19
        float hx = matrix.get(veHBuf, slotNow, j)
        if not na(hx)
            veCnt += 1
            if hx < veMove / c_
                veBelow += 1
    if veCnt >= 10
        vePct := 100.0 * veBelow / veCnt
if barstate.isconfirmed and slotNow >= 0 and not na(veMove)
    for j = 0 to 18
        matrix.set(veHBuf, slotNow, j, matrix.get(veHBuf, slotNow, j + 1))
    matrix.set(veHBuf, slotNow, 19, veMove / c_)
bool veAccel = not na(vePct) and not na(vePct[12]) and vePct - vePct[12] >= 20
bool exitUp = not na(veMove[veK]) and c_ > c_[veK] + veMove[veK]
bool exitDn = not na(veMove[veK]) and c_ < c_[veK] - veMove[veK]
// target odds by trend strength (H4.3)
int veQ = tvS0 > 0.5879 ? 4 : tvS0 > 0.4241 ? 3 : tvS0 > 0.2934 ? 2 : tvS0 > 0.183 ? 1 : 0
string veP1 = tvState > 0 and veQ == 4 ? "31%" : tvState != 0 and veQ == 0 ? "21%" : "25%"
string veP2 = tvState < 0 and veQ == 2 ? "7%" : "8%"
// trailing stop for the current trend state (H4.5), with its hit state
var float veBest = na
var float veTrailD = na
var bool veHit = false
if tvState != tvState[1]
    veBest := tvState > 0 ? h_ : tvState < 0 ? l_ : na
    veTrailD := tvState != 0 ? 0.75 * veMove : na
    veHit := false
else if tvState > 0
    veBest := math.max(nz(veBest, h_), h_)
else if tvState < 0
    veBest := math.min(nz(veBest, l_), l_)
float veTrailStop = tvState > 0 ? veBest - veTrailD : tvState < 0 ? veBest + veTrailD : na
if not na(veTrailStop) and ((tvState > 0 and c_ < veTrailStop) or (tvState < 0 and c_ > veTrailStop))
    veHit := true
// day range and the remaining move to the close (H3.2; 5-minute charts only)
int veBarsDay = timeframe.isintraday ? math.max(1, math.ceil(390.0 / tfMin)) : 1
var float veDayHi = na
var float veDayLo = na
var float veDayOpen = na
var int veDayBar = na
if timeframe.isintraday and newSess and not na(veS2)
    float veDm = math.sqrt(veBarsDay * veS2) * o_
    veDayHi := o_ + veDm
    veDayLo := o_ - veDm
    veDayOpen := o_
    veDayBar := bar_index
var float veRunHi = na
var float veRunLo = na
veRunHi := newSess ? h_ : math.max(nz(veRunHi, h_), h_)
veRunLo := newSess ? l_ : math.min(nz(veRunLo, l_), l_)
float veFuel = na(veDayHi) ? na : (veRunHi - veRunLo) / (veDayHi - veDayLo)
int veSlot5end = timeframe.isintraday and slotNow >= 0 ? math.min(77, math.max(0, math.floor((slotNow + 1) * tfMin / 5.0) - 1)) : -1
float veRemMove = tfMin == 5 and veSlot5end >= 0 ? array.get(veG5, veSlot5end) * math.sqrt(veS2) * c_ : na
float veVix = request.security("CBOE:VIX", "D", close, lookahead=barmerge.lookahead_off)
float veVixPct = request.security("CBOE:VIX", "D", ta.percentrank(close, 500), lookahead=barmerge.lookahead_off)
float veV3 = request.security("CBOE:VIX3M", "D", close, lookahead=barmerge.lookahead_off)

// ═══════════════ الرسم ═══════════════
bool mFull = pMode == "النافذة الكاملة (الشموع والأدوات)"
bool mStack = pMode == "ثلاثة أجزاء في نافذة واحدة"
bool mAll  = pMode == "الكلّ في نافذة واحدة"
bool mRvol = pRvol and (mAll or pMode == "الفوليوم الآن فقط")
bool mMove = pMove and (mAll or pMode == "الحركة المتوقّعة والانضغاط فقط")
bool mSqz  = pSqz and (mAll or pMode == "الحركة المتوقّعة والانضغاط فقط")
bool mHeat = pHeat and (mAll or pMode == "شريط الحرارة فقط")
color rvCol = na(rvol) ? cNorm : rvol >= 2 ? cHot : rvol >= 1.2 ? cUp : cNorm
plot(mRvol ? rvol : na, "الفوليوم الآن RVOL", color=rvCol, style=plot.style_columns)
plot(mRvol ? 1 : na, "RVOL = 1", color=color.new(#9598a1, 40), style=plot.style_line, linewidth=1)
plot(mAll or pMode == "شريط الحرارة فقط" ? 0 : na, "الصفر", color=color.new(#9598a1, 70))
// in its own pane the expected move is drawn in true percent; beside the RVOL columns it is scaled by the multiplier
plot(mMove ? veMovePct * (mAll ? pMoveX : 1) : na, "الحركة المتوقّعة %" + " (× المضاعف في النافذة المشتركة)", color=cMove, linewidth=2)
plot(veMovePct, "الحركة المتوقّعة %", color=na, display=display.data_window)
plot(veMove, "الحركة المتوقّعة (سعر)", color=na, display=display.data_window)
plot(veComp, "انضغاط ATR14/ATR100", color=na, display=display.data_window)
bgcolor(mSqz and veSqzOn ? color.new(cSqz, 70) : na, title="الانضغاط")
// heat strip: a column per bar below the zero line
color heatCol = veSqzOn ? cSqz : na(vePct) ? cNorm : vePct < 50 ? color.from_gradient(vePct, 0, 50, #1a1a2e, #1e88e5) : color.from_gradient(vePct, 50, 100, #1e88e5, #ffd600)
// alone in a pane the strip fills it (0..1); under the columns it sits below zero
plot(mHeat ? (mAll ? -0.15 : 1) : na, "حرارة التذبذب", color=heatCol, style=plot.style_columns, histbase=mAll ? -0.45 : 0)
plotshape(mHeat and exitUp, "خروج فوق النطاق", style=shape.triangleup, location=location.bottom, color=cUp, size=size.tiny)
plotshape(mHeat and exitDn, "خروج تحت النطاق", style=shape.triangledown, location=location.bottom, color=#ef5350, size=size.tiny)
// ═══════════════ ثلاثة أجزاء في نافذة واحدة ═══════════════
// band 3 (2..3): RVOL columns, 3x fills the band; band 2 (1..2): expected-move percent rank, squeeze shades the band;
// band 1 (0..1): the heat strip
bool sRvol = mStack and pRvol
bool sMove = mStack and pMove
bool sHeat = mStack and pHeat
plot(sRvol ? 2 + math.min(nz(rvol), 3) / 3 : na, "جزء الفوليوم الآن", color=rvCol, style=plot.style_columns, histbase=2)
plot(sRvol ? 2 + 1.0 / 3 : na, "جزء الفوليوم: خطّ 1×", color=color.new(#9598a1, 40))
pB1 = plot(mStack ? 1 : na, "فاصل 1", color=color.new(#9598a1, 30))
pB2 = plot(mStack ? 2 : na, "فاصل 2", color=color.new(#9598a1, 30))
plot(mStack ? 3 : na, "السقف", color=color.new(#9598a1, 30))
plot(mStack ? 0 : na, "القاع", color=color.new(#9598a1, 30))
fill(pB1, pB2, color=mStack and pSqz and veSqzOn ? color.new(cSqz, 60) : na, title="جزء الحركة: الانضغاط")
plot(sMove ? 1 + nz(vePct, 50) / 100 : na, "جزء الحركة المتوقّعة (ترتيبها بين 500 شمعة)", color=cMove, linewidth=2)
plot(sHeat ? 1 : na, "جزء الحرارة", color=heatCol, style=plot.style_columns, histbase=0)
plotshape(sHeat and exitUp, "جزء الحرارة: خروج فوق", style=shape.triangleup, location=location.bottom, color=cUp, size=size.tiny)
plotshape(sHeat and exitDn, "جزء الحرارة: خروج تحت", style=shape.triangledown, location=location.bottom, color=#ef5350, size=size.tiny)
var label[] sLbl = array.new_label()
if mStack and barstate.islast
    for lb in sLbl
        label.delete(lb)
    array.clear(sLbl)
    array.push(sLbl, label.new(bar_index, 2.95, "الفوليوم الآن RVOL · أصفر ≥ 2× أخضر ≥ 1.2×", style=label.style_label_right, color=color.new(#1e222d, 30), textcolor=#9598a1, size=size.tiny))
    array.push(sLbl, label.new(bar_index, 1.95, "الحركة المتوقّعة (ترتيبها) · بنفسجي = انضغاط", style=label.style_label_right, color=color.new(#1e222d, 30), textcolor=#9598a1, size=size.tiny))
    array.push(sLbl, label.new(bar_index, 0.95, "حرارة التذبذب · ▲▼ خروج من النطاق", style=label.style_label_right, color=color.new(#1e222d, 30), textcolor=#9598a1, size=size.tiny))

// ═══════════════ النافذة الكاملة: الشموع والأدوات ═══════════════
plotcandle(mFull ? o_ : na, mFull ? h_ : na, mFull ? l_ : na, mFull ? c_ : na, title="الشموع", color=c_ >= o_ ? cUp : cDn, wickcolor=c_ >= o_ ? cUp : cDn, bordercolor=c_ >= o_ ? cUp : cDn)
plot(mFull and pTrail ? veTrailStop : na, "وقف متحرّك 0.75×", color=veHit ? color.new(#78909c, 20) : color.new(cTrail, 0), style=plot.style_linebr, linewidth=2)
plotshape(mFull and pExits and exitUp, "خروج فوق النطاق", style=shape.triangleup, location=location.abovebar, color=cUp, size=size.tiny)
plotshape(mFull and pExits and exitDn, "خروج تحت النطاق", style=shape.triangledown, location=location.belowbar, color=cDn, size=size.tiny)
plot(veMove, "الحركة المتوقّعة (1σ)", color=na, display=display.data_window)
plot(vePct, "حرارة التذبذب (ترتيب وقت اليوم)", color=na, display=display.data_window)
plot(veRemMove, "المتبقّي حتى الإغلاق (1σ)", color=na, display=display.data_window)
// day lines (one pair per session, extended to the right)
var line veDL1 = na
var line veDL2 = na
var label veDLb1 = na
var label veDLb2 = na
if mFull and pDay and timeframe.isintraday and newSess and not na(veDayHi)
    line.delete(veDL1), line.delete(veDL2), label.delete(veDLb1), label.delete(veDLb2)
    veDL1 := line.new(bar_index, veDayHi, bar_index + 1, veDayHi, extend=extend.right, color=color.new(cDay, 20), style=line.style_dashed, width=2)
    veDL2 := line.new(bar_index, veDayLo, bar_index + 1, veDayLo, extend=extend.right, color=color.new(cDay, 20), style=line.style_dashed, width=2)
    veDLb1 := label.new(bar_index, veDayHi, "أعلى اليوم المتوقّع", style=label.style_label_lower_right, color=color.new(cDay, 100), textcolor=cDay, size=size.small)
    veDLb2 := label.new(bar_index, veDayLo, "أدنى اليوم المتوقّع", style=label.style_label_upper_right, color=color.new(cDay, 100), textcolor=cDay, size=size.small)
// fan + ladder + remaining, redrawn on the last bar
var line[] fLines = array.new_line()
var box[] fBoxes = array.new_box()
var label[] fLabels = array.new_label()
if mFull and barstate.islast and not na(veMove)
    for ln in fLines
        line.delete(ln)
    for bx in fBoxes
        box.delete(bx)
    for lb in fLabels
        label.delete(lb)
    array.clear(fLines), array.clear(fBoxes), array.clear(fLabels)
    int xe = bar_index + veK
    if pFan
        array.push(fBoxes, box.new(bar_index, c_ + 2 * veMove, xe, c_ - 2 * veMove, border_color=color.new(cMove, 80), bgcolor=color.new(cMove, 88)))
        array.push(fBoxes, box.new(bar_index, c_ + veMove, xe, c_ - veMove, border_color=color.new(cMove, 70), bgcolor=color.new(cMove, 78)))
        for m = 1 to 2
            array.push(fLines, line.new(bar_index, c_, xe, c_ + m * veMove, color=color.new(cMove, m == 1 ? 10 : 50), width=m == 1 ? 2 : 1, style=line.style_dashed))
            array.push(fLines, line.new(bar_index, c_, xe, c_ - m * veMove, color=color.new(cMove, m == 1 ? 10 : 50), width=m == 1 ? 2 : 1, style=line.style_dashed))
            array.push(fLabels, label.new(xe, c_ + m * veMove, "+" + str.tostring(m) + "σ", style=label.style_label_left, color=color.new(cMove, 100), textcolor=cMove, size=size.small))
            array.push(fLabels, label.new(xe, c_ - m * veMove, "−" + str.tostring(m) + "σ", style=label.style_label_left, color=color.new(cMove, 100), textcolor=cMove, size=size.small))
        array.push(fLines, line.new(bar_index, c_, xe + 3, c_, color=color.new(cDn, 30), width=1, style=line.style_dotted))
        array.push(fLabels, label.new(xe + 3, c_, str.tostring(c_, format.mintick), style=label.style_label_left, color=cDn, textcolor=color.white, size=size.small))
    if pLadder
        array.push(fLines, line.new(bar_index, c_ + veMove, xe, c_ + veMove, color=cTgt, width=2, style=line.style_dashed))
        array.push(fLines, line.new(bar_index, c_ + 2 * veMove, xe, c_ + 2 * veMove, color=cTgt, width=2, style=line.style_dashed))
        array.push(fLines, line.new(bar_index, c_ - 0.75 * veMove, xe, c_ - 0.75 * veMove, color=cDn, width=2))
        array.push(fLabels, label.new(xe, c_ + 0.85 * veMove, "هدف 1× · " + veP1 + (veP1 != "25%" ? " (قوة الاتجاه)" : ""), style=label.style_label_left, color=color.new(cTgt, 100), textcolor=cTgt, size=size.small))
        array.push(fLabels, label.new(xe, c_ + 1.85 * veMove, "هدف 2× · " + veP2, style=label.style_label_left, color=color.new(cTgt, 100), textcolor=cTgt, size=size.small))
        array.push(fLabels, label.new(xe, c_ - 0.75 * veMove, "وقف 0.75× · يُضرب 5%", style=label.style_label_left, color=color.new(cDn, 100), textcolor=cDn, size=size.small))
    if pRem and not na(veRemMove) and slotNow >= 0
        int xend = bar_index + (nSlots - 1 - slotNow)
        array.push(fLines, line.new(bar_index, c_ + veRemMove, xend, c_ + veRemMove, color=color.new(cMove, 30), width=1, style=line.style_dotted))
        array.push(fLines, line.new(bar_index, c_ - veRemMove, xend, c_ - veRemMove, color=color.new(cMove, 30), width=1, style=line.style_dotted))
        array.push(fLabels, label.new(xend, c_ - veRemMove, "حتى الإغلاق ±" + str.tostring(veRemMove, format.mintick), style=label.style_label_up, color=color.new(cMove, 100), textcolor=color.new(cMove, 10), size=size.tiny))
    if pTrail and not na(veTrailStop)
        array.push(fLabels, label.new(bar_index + 1, veTrailStop, "وقف متحرّك 0.75×" + (veHit ? " · ضُرب" : ""), style=label.style_label_left, color=color.new(cTrail, 100), textcolor=veHit ? #78909c : cTrail, size=size.small))
// strips under the drawing: one box per bar below the lowest low of the window; colour = heat, purple = squeeze
var box[] stripHeat = array.new_box()
var box[] stripSqz = array.new_box()
float sY0 = ta.lowest(l_, pStripN) - 1.4 * atrV
float sH = 0.45 * atrV
color heatC = veSqzOn ? cSqz : na(vePct) ? cNorm : vePct < 50 ? color.from_gradient(vePct, 0, 50, #1a1a2e, #1e88e5) : color.from_gradient(vePct, 50, 100, #1e88e5, #ffd600)
if mFull and pStrips and barstate.isconfirmed and not na(sY0)
    array.push(stripHeat, box.new(bar_index, sY0 + sH, bar_index + 1, sY0, border_color=color.new(heatC, 100), bgcolor=heatC))
    array.push(stripSqz, box.new(bar_index, sY0 - 0.3 * atrV, bar_index + 1, sY0 - 0.3 * atrV - sH, border_color=color.new(cSqz, 100), bgcolor=veSqzOn ? cSqz : color.new(#2a2e39, 0)))
    if array.size(stripHeat) > pStripN
        box.delete(array.shift(stripHeat))
        box.delete(array.shift(stripSqz))
    for bx in stripHeat
        box.set_top(bx, sY0 + sH), box.set_bottom(bx, sY0)
    for bx in stripSqz
        box.set_top(bx, sY0 - 0.3 * atrV), box.set_bottom(bx, sY0 - 0.3 * atrV - sH)
// an invisible plot at the strips' floor so the pane's auto-scale includes them (boxes alone do not stretch it)
plot(mFull and pStrips ? sY0 - 0.3 * atrV - sH - 0.2 * atrV : na, "قاع الشريطين", color=color.new(#2a2e39, 60), linewidth=1)
var label sLb1 = na
var label sLb2 = na
if mFull and pStrips and barstate.islast and not na(sY0)
    label.delete(sLb1), label.delete(sLb2)
    sLb1 := label.new(bar_index + 1, sY0 + sH / 2, "حرارة التذبذب حسب وقت اليوم" + (na(vePct) ? "" : ": الآن " + str.tostring(vePct, "#") + "%") + (veAccel ? " ↑ تتسارع" : ""), style=label.style_label_left, color=color.new(cHot, 100), textcolor=cHot, size=size.small)
    sLb2 := label.new(bar_index + 1, sY0 - 0.3 * atrV - sH / 2, "الانضغاط" + (veSqzOn ? ": نعم منذ " + str.tostring(veSqzBars) + " شمعة · اصبر" : " (بنفسجي عند حدوثه) · أهدأ في الغداء وعلى فوليوم منخفض"), style=label.style_label_left, color=color.new(cSqz, 100), textcolor=cSqz, size=size.small)
// the state box
int nDn = math.round(math.sum(exitDn ? 1.0 : 0.0, 12))
int nUp = math.round(math.sum(exitUp ? 1.0 : 0.0, 12))
bPos = pBoxPos == "وسط اليمين" ? position.middle_right : pBoxPos == "أعلى اليمين" ? position.top_right : pBoxPos == "أسفل اليمين" ? position.bottom_right : position.top_left
var table sb = table.new(bPos, 2, 12, bgcolor=color.new(#1e222d, 8), border_color=color.new(#3a3f4b, 0), border_width=1, frame_color=color.new(#3a3f4b, 0), frame_width=1)
if mFull and pBox and barstate.islast
    string dirW = tvState > 0 ? "صاعد" : tvState < 0 ? "هابط" : "لا اتجاه"
    color dirC = tvState > 0 ? cUp : tvState < 0 ? cDn : #9598a1
    bool hot = not na(vePct) and vePct >= 80
    string verdict = tvState != 0 and veHit ? "الاتجاه " + dirW + " لكنّ وقفه المتحرّك ضُرب: لا صفقة جديدة حتى حالة جديدة" + (hot ? "؛ اليوم ساخن فصغّر الحجم" : "") : tvState != 0 ? "الاتجاه " + dirW + ": الصفقات معه فقط، الوقف المتحرّك " + str.tostring(veTrailStop, format.mintick) + "، هدف 1× " + veP1 + (hot ? "؛ اليوم ساخن فصغّر الحجم" : "") : "لا اتجاه: استعمل الوقف والهدف فقط" + (hot ? "؛ اليوم ساخن" : "")
    if veSqzOn
        verdict += "؛ انضغاط: اصبر"
    table.cell(sb, 1, 0, "الحالة الآن " + str.format_time(time, "HH:mm", syminfo.timezone), text_color=#d1d4dc, text_size=size.normal, text_halign=text.align_right)
    table.cell(sb, 0, 0, "", text_size=size.small)
    table.merge_cells(sb, 0, 0, 1, 0)
    table.cell(sb, 1, 1, "الاتجاه", text_color=#9598a1, text_size=size.small, text_halign=text.align_right)
    table.cell(sb, 0, 1, dirW, text_color=dirC, text_size=size.small, text_halign=text.align_left)
    table.cell(sb, 1, 2, "الحركة المتوقّعة", text_color=#9598a1, text_size=size.small, text_halign=text.align_right)
    table.cell(sb, 0, 2, "±" + str.tostring(veMove, format.mintick) + " (" + str.tostring(veMovePct, "#.00") + "%) في " + str.tostring(veK) + " شمعة", text_color=cMove, text_size=size.small, text_halign=text.align_left)
    table.cell(sb, 1, 3, "هدف 1× / 2×", text_color=#9598a1, text_size=size.small, text_halign=text.align_right)
    table.cell(sb, 0, 3, veP1 + " / " + veP2, text_color=cTgt, text_size=size.small, text_halign=text.align_left)
    table.cell(sb, 1, 4, "الوقف الثابت", text_color=#9598a1, text_size=size.small, text_halign=text.align_right)
    table.cell(sb, 0, 4, str.tostring(tvState < 0 ? c_ + 0.75 * veMove : c_ - 0.75 * veMove, format.mintick) + " (0.75×)", text_color=cDn, text_size=size.small, text_halign=text.align_left)
    table.cell(sb, 1, 5, "الوقف المتحرّك", text_color=#9598a1, text_size=size.small, text_halign=text.align_right)
    table.cell(sb, 0, 5, na(veTrailStop) ? "لا اتجاه" : str.tostring(veTrailStop, format.mintick) + (veHit ? " · ضُرب، انتظر حالة جديدة" : ""), text_color=veHit ? #78909c : cTrail, text_size=size.small, text_halign=text.align_left)
    table.cell(sb, 1, 6, "مدى اليوم", text_color=#9598a1, text_size=size.small, text_halign=text.align_right)
    table.cell(sb, 0, 6, na(veFuel) ? "-" : "مستهلك " + str.tostring(100 * veFuel, "#") + "%", text_color=cDay, text_size=size.small, text_halign=text.align_left)
    table.cell(sb, 1, 7, "حتى الإغلاق", text_color=#9598a1, text_size=size.small, text_halign=text.align_right)
    table.cell(sb, 0, 7, na(veRemMove) ? "-" : "±" + str.tostring(veRemMove, format.mintick), text_color=cMove, text_size=size.small, text_halign=text.align_left)
    table.cell(sb, 1, 8, "الحرارة", text_color=#9598a1, text_size=size.small, text_halign=text.align_right)
    table.cell(sb, 0, 8, na(vePct) ? "-" : str.tostring(vePct, "#") + "%" + (vePct >= 80 ? " ساخن" : vePct < 20 ? " بارد" : "") + (veAccel ? " ↑ تتسارع" : ""), text_color=cHot, text_size=size.small, text_halign=text.align_left)
    table.cell(sb, 1, 9, "الانضغاط", text_color=#9598a1, text_size=size.small, text_halign=text.align_right)
    table.cell(sb, 0, 9, veSqzOn ? "نعم منذ " + str.tostring(veSqzBars) + " شمعة: اصبر" + (veLunch ? " (غداء: أهدأ)" : "") : (veComp[1] < veThr ? "خرج: ليس بداية حركة" : "لا"), text_color=cSqz, text_size=size.small, text_halign=text.align_left)
    table.cell(sb, 1, 10, "الخروج من النطاق", text_color=#9598a1, text_size=size.small, text_halign=text.align_right)
    table.cell(sb, 0, 10, str.tostring(nDn) + " هبوطًا، " + str.tostring(nUp) + " صعودًا في آخر ساعة", text_color=nDn > nUp ? cDn : nUp > nDn ? cUp : #9598a1, text_size=size.small, text_halign=text.align_left)
    table.cell(sb, 0, 11, verdict, text_color=cHot, text_size=size.small, text_halign=text.align_right)
    table.merge_cells(sb, 0, 11, 1, 11)
// numbers table
tPos = pTblPos == "أعلى اليمين" ? position.top_right : pTblPos == "أعلى اليسار" ? position.top_left : pTblPos == "أسفل اليسار" ? position.bottom_left : position.bottom_right
var table tb = table.new(tPos, 2, 4, bgcolor=color.new(#1e222d, 10), border_color=color.new(#2a2e39, 0), border_width=1)
if pTbl and not mFull and barstate.islast
    string sVol = na(rvol) ? "-" : str.tostring(rvol, "#.0") + "× " + (rvol >= 2 ? "عالٍ جدًا" : rvol >= 1.2 ? "قوي" : "عادي")
    string sMv = na(veMove) ? "-" : "±" + str.tostring(veMove, format.mintick) + " (" + str.tostring(veMovePct, "#.00") + "%) / " + str.tostring(veK) + " شمعة"
    string sStop = na(veMove) ? "-" : "≥ " + str.tostring(0.75 * veMove, format.mintick) + " (0.75×) · ATR واحد يُضرب 41%"
    string sVix = (na(vePct) ? "" : "حرارة " + str.tostring(vePct, "#") + "%" + (veAccel ? " ↑ تتسارع" : "") + " · ") + (na(veVixPct) ? "-" : "VIX " + str.tostring(veVixPct, "#") + "% " + (veVixPct >= 80 ? "خوف عالٍ · ميل 60 يومًا +3.8 SPY" : veVixPct <= 20 ? "هدوء" : "عادي") + (not na(veV3) and veVix > veV3 ? " · VIX فوق VIX3M" : "")) + (veSqzOn ? " · انضغاط منذ " + str.tostring(veSqzBars) + (veLunch ? " (غداء: أهدأ)" : "") : (veComp[1] < veThr ? " · خرج من الانضغاط: ليس بداية حركة" : ""))
    table.clear(tb, 0, 0, 1, 3)
    if mRvol or sRvol
        table.cell(tb, 1, 0, "الفوليوم الآن", text_color=#9598a1, text_size=size.small, text_halign=text.align_right)
        table.cell(tb, 0, 0, sVol, text_color=rvCol == cNorm ? #d1d4dc : rvCol, text_size=size.small, text_halign=text.align_right)
    if mMove or sMove
        table.cell(tb, 1, 1, "الحركة المتوقّعة", text_color=#9598a1, text_size=size.small, text_halign=text.align_right)
        table.cell(tb, 0, 1, sMv, text_color=cMove, text_size=size.small, text_halign=text.align_right)
        table.cell(tb, 1, 2, "وقف يصمد للضجيج", text_color=#9598a1, text_size=size.small, text_halign=text.align_right)
        table.cell(tb, 0, 2, sStop, text_color=#d1d4dc, text_size=size.small, text_halign=text.align_right)
    if mMove or mHeat or mStack
        table.cell(tb, 1, 3, "السياق", text_color=#9598a1, text_size=size.small, text_halign=text.align_right)
        table.cell(tb, 0, 3, sVix, text_color=veSqzOn ? cSqz : #d1d4dc, text_size=size.small, text_halign=text.align_right)
alertcondition(veSqzOn and not veSqzOn[1], "انضغاط", "دخل السعر في انضغاط (ATR14/ATR100 تحت عُشره المعتاد)")
alertcondition(not na(rvol) and rvol >= 2, "فوليوم عالٍ جدًا", "RVOL ≥ 2× لنفس الدقيقة")
alertcondition(veHit and not veHit[1], "ضُرب الوقف المتحرّك", "الإغلاق عبر الوقف المتحرّك للاتجاه الحالي")

//@version=5
// Volume Zones
// Rolling volume profile (POC / VAH / VAL / HVN), weak-volume pools,
// pool breakouts that hunt previous volume zones in a strong trend,
// HVN rejections, ranked top-3 zones, status table and a Viridis
// strip heatmap (no smoothing) with an optional buy / sell layer.
// Mirrors vzones/indicator.py: the profile is built from past bars only.
indicator("Volume Zones", overlay=true, max_bars_back=500, max_lines_count=100, max_boxes_count=500, max_labels_count=200)

// ═══════════════ Inputs ═══════════════
lookback   = input.int(120, "Profile lookback (bars)", minval=20, maxval=400, group="Profile")
rows       = input.int(40, "Profile rows", minval=10, maxval=100, group="Profile")
vaPct      = input.float(0.70, "Value area %", group="Profile")
hvnMult    = input.float(1.5, "HVN = row vol > x * mean", group="Profile")

volMaLen   = input.int(20, "Volume SMA", group="Signals")
weakRatio  = input.float(0.80, "Weak volume: vol/SMA <", group="Signals")
weakBars   = input.int(4, "Bars to form a weak pool", minval=2, group="Signals")
poolMaxAtr = input.float(2.5, "Pool max range (ATR)", group="Signals")
breakRatio = input.float(1.5, "Break volume: vol/SMA >=", group="Signals")
adxLen     = input.int(14, "ADX length", group="Signals")
adxStrong  = input.float(25, "Strong trend ADX >=", group="Signals")
minTgtAtr  = input.float(1.0, "Min target distance (ATR)", group="Signals")
maxTgtAtr  = input.float(12.0, "Max target distance (ATR)", group="Signals")
wickPct    = input.float(0.5, "Rejection wick share", group="Signals")

showTop    = input.bool(true, "Show top-3 zones", group="Zones")
tblPos     = input.string("Bottom Right", "Table position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group="Zones")
showVA     = input.bool(true, "Show POC / VAH / VAL", group="Zones")

showHeat   = input.bool(true, "Show heatmap (Viridis strips)", group="Heatmap")
heatStep   = input.int(3, "Heatmap column width (bars)", minval=1, group="Heatmap")
heatMin    = input.float(0.40, "Hide rows below (0-1 of max)", minval=0.0, maxval=0.95, group="Heatmap")
heatAlpha  = input.int(35, "Heatmap transparency", minval=0, maxval=95, group="Heatmap")
stripGap   = input.float(0.18, "Gap between strips (0-0.45 of row)", minval=0.0, maxval=0.45, group="Heatmap")
showDelta  = input.bool(false, "Buy / Sell layer (green buyers, red sellers)", group="Heatmap")
deltaMin   = input.float(0.55, "Buy/Sell layer: only rows above (0-1 of max)", group="Heatmap")
deltaEdge  = input.float(0.12, "Buy/Sell layer: min imbalance (0-0.5)", group="Heatmap")
showLegend = input.bool(true, "Show colour legend", group="Heatmap")
showSplit  = input.bool(true, "Show Up/Down profile on last bar", group="Heatmap")

// ═══════════════ Volume / trend ═══════════════
atrV  = ta.atr(14)
volMa = ta.sma(volume, volMaLen)
vr    = volMa > 0 ? volume / volMa : 1.0
weak  = vr < weakRatio
strongVol = vr >= breakRatio
[diP, diM, adxV] = ta.dmi(adxLen, adxLen)
emaF = ta.ema(close, 20)
emaS = ta.ema(close, 50)
trendDir = emaF > emaS and diP > diM ? 1 : emaF < emaS and diM > diP ? -1 : 0

// ═══════════════ Rolling volume profile (bars 1..lookback, past only) ═══════════════
var float[] rowVol = array.new_float(rows, 0.0)
var float[] rowBuy = array.new_float(rows, 0.0)
var float[] hvnLo  = array.new_float()
var float[] hvnHi  = array.new_float()
pHi  = ta.highest(high, lookback)[1]
pLo  = ta.lowest(low, lookback)[1]
step = (pHi - pLo) / rows
float poc = na
float vah = na
float val = na
ready = bar_index > lookback and step > 0

if ready
    array.fill(rowVol, 0.0)
    array.fill(rowBuy, 0.0)
    for i = 1 to lookback
        bh = high[i]
        bl = low[i]
        bv = nz(volume[i])
        isUp = close[i] >= open[i]
        rng = math.max(bh - bl, syminfo.mintick)
        r0 = math.max(0, math.min(rows - 1, int((bl - pLo) / step)))
        r1 = math.max(0, math.min(rows - 1, int((bh - pLo) / step)))
        for r = r0 to r1
            rLo = pLo + r * step
            rHi = rLo + step
            ov = math.max(0.0, math.min(bh, rHi) - math.max(bl, rLo))
            add = bh == bl ? bv : bv * ov / rng
            array.set(rowVol, r, array.get(rowVol, r) + add)
            if isUp
                array.set(rowBuy, r, array.get(rowBuy, r) + add)
    total = array.sum(rowVol)
    pocI = array.indexof(rowVol, array.max(rowVol))
    loI = pocI
    hiI = pocI
    acc = array.get(rowVol, pocI)
    while acc < vaPct * total and (loI > 0 or hiI < rows - 1)
        upV1 = hiI < rows - 1 ? array.get(rowVol, hiI + 1) : -1.0
        dnV1 = loI > 0 ? array.get(rowVol, loI - 1) : -1.0
        if upV1 >= dnV1
            hiI += 1
            acc += upV1
        else
            loI -= 1
            acc += dnV1
    poc := pLo + (pocI + 0.5) * step
    vah := pLo + (hiI + 1) * step
    val := pLo + loI * step
    array.clear(hvnLo)
    array.clear(hvnHi)
    mean = total / rows
    inRun = false
    for r = 0 to rows - 1
        isH = array.get(rowVol, r) > hvnMult * mean
        if isH and not inRun
            array.push(hvnLo, pLo + r * step)
            array.push(hvnHi, pLo + (r + 1) * step)
            inRun := true
        else if isH and inRun
            array.set(hvnHi, array.size(hvnHi) - 1, pLo + (r + 1) * step)
        else
            inRun := false

nZones = array.size(hvnLo)

// ═══════════════ Nearest targets (HVN edges, POC, VA edges) ═══════════════
float tgtUp = na
float tgtDn = na
cands = array.new_float()
if nZones > 0
    for k = 0 to nZones - 1
        array.push(cands, array.get(hvnLo, k))
        array.push(cands, array.get(hvnHi, k))
if not na(poc)
    array.push(cands, poc)
    array.push(cands, vah)
    array.push(cands, val)
if array.size(cands) > 0 and atrV > 0
    for k = 0 to array.size(cands) - 1
        x = array.get(cands, k)
        dist = math.abs(x - close) / atrV
        if dist >= minTgtAtr and dist <= maxTgtAtr
            if x > close and (na(tgtUp) or x < tgtUp)
                tgtUp := x
            if x < close and (na(tgtDn) or x > tgtDn)
                tgtDn := x
inHvn = false
if nZones > 0
    for k = 0 to nZones - 1
        if close >= array.get(hvnLo, k) and close <= array.get(hvnHi, k)
            inHvn := true

// ═══════════════ Weak-volume pool → break → HUNT ═══════════════
var int poolStart = na
winRng  = ta.highest(high, weakBars) - ta.lowest(low, weakBars)
weakCnt = math.sum(weak ? 1 : 0, weakBars)
if na(poolStart) and weakCnt >= weakBars - 1 and winRng <= poolMaxAtr * atrV
    poolStart := bar_index - weakBars + 1

int brk = 0
int hunt = 0
float poolH = na
float poolL = na
float huntTgt = na
if not na(poolStart)
    len = math.min(bar_index - poolStart, 400)
    if len >= 1
        float ph = high[1]
        float pl = low[1]
        for i = 1 to len
            ph := math.max(ph, high[i])
            pl := math.min(pl, low[i])
        poolH := ph
        poolL := pl
    if not na(poolH) and close > poolH and strongVol
        brk := 1
    else if not na(poolL) and close < poolL and strongVol
        brk := -1
    if brk != 0
        t = brk > 0 ? tgtUp : tgtDn
        emaOk = brk > 0 ? emaF > emaS : emaF < emaS
        if not na(t) and adxV >= adxStrong and emaOk
            hunt := brk
            huntTgt := t
        poolStart := na
    else if not na(poolH) and (poolH - poolL) > poolMaxAtr * atrV
        poolStart := na

// ═══════════════ Rejection at an HVN edge ═══════════════
int rej = 0
rngB = high - low
if rngB > 0 and nZones > 0
    uw = (high - math.max(open, close)) / rngB
    lw = (math.min(open, close) - low) / rngB
    for k = 0 to nZones - 1
        zLo = array.get(hvnLo, k)
        zHi = array.get(hvnHi, k)
        if low < zLo and high >= zLo and close < zLo and close < open and uw >= wickPct
            rej := -1
        if low <= zHi and high > zHi and close > zHi and close > open and lw >= wickPct
            rej := 1

// ═══════════════ Plots & candles ═══════════════
plot(showVA ? poc : na, "POC", color.new(#ff4d4d, 0), 1, plot.style_stepline)
plot(showVA ? vah : na, "VAH", color.new(color.gray, 40), 1, plot.style_stepline)
plot(showVA ? val : na, "VAL", color.new(color.gray, 40), 1, plot.style_stepline)
barcolor(strongVol ? (close >= open ? #00e676 : #ff1744) : weak ? #4a4e5a : na, title="Volume regime candles")
plotshape(brk == 1 and hunt == 0, "Pool break up", shape.triangleup, location.belowbar, color.teal, size=size.tiny)
plotshape(brk == -1 and hunt == 0, "Pool break down", shape.triangledown, location.abovebar, color.maroon, size=size.tiny)
plotshape(hunt == 1, "HUNT up", shape.labelup, location.belowbar, color.lime, text="HUNT", textcolor=color.black)
plotshape(hunt == -1, "HUNT down", shape.labeldown, location.abovebar, color.red, text="HUNT", textcolor=color.white)
plotshape(rej == 1, "HVN rejection bull", shape.circle, location.belowbar, color.aqua, size=size.tiny)
plotshape(rej == -1, "HVN rejection bear", shape.circle, location.abovebar, color.orange, size=size.tiny)
if hunt != 0
    line.new(bar_index, huntTgt, bar_index + 20, huntTgt, color=hunt > 0 ? color.lime : color.red, style=line.style_dashed, width=2)
    label.new(bar_index + 20, huntTgt, "TARGET " + str.tostring(huntTgt, format.mintick), style=label.style_none, textcolor=hunt > 0 ? color.lime : color.red, size=size.small)

// weak pool as a dotted box
var box poolBox = na
if not na(poolStart) and not na(poolH)
    if na(poolBox)
        poolBox := box.new(poolStart, math.max(poolH, high), bar_index, math.min(poolL, low), border_color=color.new(color.gray, 20), border_style=line.style_dotted, bgcolor=color.new(color.gray, 100), text="weak pool", text_color=color.gray, text_size=size.tiny, text_valign=text.align_top, text_halign=text.align_left)
    else
        box.set_right(poolBox, bar_index)
        box.set_top(poolBox, math.max(poolH, high))
        box.set_bottom(poolBox, math.min(poolL, low))
else
    poolBox := na

// ═══════════════ Top-3 volume zones (ranked, % of zone volume) ═══════════════
var box[] topBoxes = array.new_box()
if showTop and barstate.islast and nZones > 0
    for b in topBoxes
        box.delete(b)
    array.clear(topBoxes)
    zv = array.new_float()
    for k = 0 to nZones - 1
        sv = 0.0
        for r = 0 to rows - 1
            mid = pLo + (r + 0.5) * step
            if mid >= array.get(hvnLo, k) and mid <= array.get(hvnHi, k)
                sv += array.get(rowVol, r)
        array.push(zv, sv)
    totZ = array.sum(zv)
    idx = array.sort_indices(zv, order.descending)
    cols = array.from(#e8432d, #e8a33d, #e8d547)
    for j = 0 to math.min(3, nZones) - 1
        k = array.get(idx, j)
        c = array.get(cols, j)
        pct = totZ > 0 ? math.round(100 * array.get(zv, k) / totZ) : 0
        txt = "#" + str.tostring(j + 1) + "  " + str.tostring(pct) + "%  " + str.tostring(array.get(hvnLo, k), format.mintick) + "-" + str.tostring(array.get(hvnHi, k), format.mintick)
        array.push(topBoxes, box.new(bar_index - lookback, array.get(hvnHi, k), bar_index + 15, array.get(hvnLo, k), border_color=color.new(c, 20), bgcolor=color.new(c, 90), text=txt, text_color=c, text_size=size.small, text_halign=text.align_right, text_valign=text.align_top))

// ═══════════════ Status table ═══════════════
tPos = tblPos == "Top Right" ? position.top_right : tblPos == "Top Left" ? position.top_left : tblPos == "Bottom Left" ? position.bottom_left : position.bottom_right
var table tbl = table.new(tPos, 2, 7, bgcolor=#1e222d, border_color=#2a2e39, border_width=1)
var int lastHunt = 0
var float lastTgt = na
if hunt != 0
    lastHunt := hunt
    lastTgt := huntTgt
if barstate.islast
    strongT = adxV >= adxStrong
    tTxt = trendDir > 0 ? (strongT ? "STRONG UP" : "UP") : trendDir < 0 ? (strongT ? "STRONG DOWN" : "DOWN") : "RANGE"
    tCol = trendDir > 0 ? #00e676 : trendDir < 0 ? #ff5252 : color.gray
    vTxt = str.tostring(vr, "#.00") + "x " + (weak ? "WEAK" : strongVol ? "STRONG" : "NORMAL")
    vCol = weak ? #f0c419 : strongVol ? #00e676 : color.white
    zTxt = inHvn ? "HVN (slow)" : "outside zone"
    sTxt = not na(poolStart) ? "WEAK POOL forming" : lastHunt != 0 ? "HUNT -> " + str.tostring(lastTgt, format.mintick) : "-"
    sCol = lastHunt > 0 ? #00e676 : lastHunt < 0 ? #ff5252 : color.white
    table.cell(tbl, 0, 0, "Trend", text_color=color.gray)
    table.cell(tbl, 1, 0, tTxt, text_color=tCol)
    table.cell(tbl, 0, 1, "ADX", text_color=color.gray)
    table.cell(tbl, 1, 1, str.tostring(adxV, "#"), text_color=color.white)
    table.cell(tbl, 0, 2, "Volume", text_color=color.gray)
    table.cell(tbl, 1, 2, vTxt, text_color=vCol)
    table.cell(tbl, 0, 3, "In zone", text_color=color.gray)
    table.cell(tbl, 1, 3, zTxt, text_color=color.white)
    table.cell(tbl, 0, 4, "Zone above", text_color=color.gray)
    table.cell(tbl, 1, 4, na(tgtUp) ? "-" : str.tostring(tgtUp, format.mintick), text_color=#ff9800)
    table.cell(tbl, 0, 5, "Zone below", text_color=color.gray)
    table.cell(tbl, 1, 5, na(tgtDn) ? "-" : str.tostring(tgtDn, format.mintick), text_color=#00bcd4)
    table.cell(tbl, 0, 6, "Signal", text_color=color.gray)
    table.cell(tbl, 1, 6, sTxt, text_color=sCol)

// ═══════════════ Heatmap: Viridis strips, no smoothing ═══════════════
// colour = volume at that price over the last `lookback` bars, relative to the busiest row (0..1)
viridis(float x) =>
    t = (x - heatMin) / math.max(1.0 - heatMin, 0.000001)
    t < 0.25 ? color.from_gradient(t, 0.00, 0.25, #440154, #3b528b) : t < 0.50 ? color.from_gradient(t, 0.25, 0.50, #3b528b, #21918c) : t < 0.75 ? color.from_gradient(t, 0.50, 0.75, #21918c, #5ec962) : color.from_gradient(t, 0.75, 1.00, #5ec962, #fde725)

var box[] heatBoxes = array.new_box()
if showHeat and ready and bar_index % heatStep == 0
    mx = array.max(rowVol)
    gap = step * stripGap
    if mx > 0
        for r = 0 to rows - 1
            v = array.get(rowVol, r)
            x = v / mx
            if x >= heatMin
                c = color.new(viridis(x), heatAlpha)
                if showDelta and x >= deltaMin and v > 0
                    share = array.get(rowBuy, r) / v - 0.5
                    if math.abs(share) >= deltaEdge
                        c := color.new(share > 0 ? #00e676 : #ff1744, math.max(heatAlpha, 100 - math.min(75, math.abs(share) * 200)))
                array.push(heatBoxes, box.new(bar_index, pLo + (r + 1) * step - gap, bar_index + heatStep - 1, pLo + r * step + gap, border_color=color.new(color.black, 100), bgcolor=c))
    while array.size(heatBoxes) > 400
        box.delete(array.shift(heatBoxes))

// colour legend
var table legend = table.new(position.bottom_center, 7, 2, bgcolor=#1e222d, border_color=#2a2e39, border_width=1)
if showLegend and showHeat and barstate.islast
    table.cell(legend, 0, 0, "less", text_color=color.gray, text_size=size.tiny)
    stops = array.from(#440154, #3b528b, #21918c, #5ec962, #fde725)
    for k = 0 to 4
        table.cell(legend, k + 1, 0, "   ", bgcolor=array.get(stops, k), text_size=size.tiny)
    table.cell(legend, 6, 0, "more volume", text_color=color.gray, text_size=size.tiny)
    if showDelta
        table.cell(legend, 0, 1, "   ", bgcolor=#00e676, text_size=size.tiny)
        table.cell(legend, 1, 1, "buyers", text_color=color.gray, text_size=size.tiny)
        table.cell(legend, 3, 1, "   ", bgcolor=#ff1744, text_size=size.tiny)
        table.cell(legend, 4, 1, "sellers", text_color=color.gray, text_size=size.tiny)

// ═══════════════ Up/Down split profile at the right edge ═══════════════
var box[] splitBoxes = array.new_box()
if showSplit and barstate.islast and ready
    for b in splitBoxes
        box.delete(b)
    array.clear(splitBoxes)
    width = 40
    mxS = array.max(rowVol)
    if mxS > 0
        for r = 0 to rows - 1
            buyV = array.get(rowBuy, r)
            sellV = array.get(rowVol, r) - buyV
            u = int(width * buyV / mxS)
            d = int(width * sellV / mxS)
            if u > 0
                array.push(splitBoxes, box.new(bar_index + 8, pLo + (r + 1) * step, bar_index + 8 + u, pLo + r * step, border_color=color.new(color.black, 100), bgcolor=color.new(#2f7fd1, 20)))
            if d > 0
                array.push(splitBoxes, box.new(bar_index + 8 + u, pLo + (r + 1) * step, bar_index + 8 + u + d, pLo + r * step, border_color=color.new(color.black, 100), bgcolor=color.new(#c9a227, 20)))

// ═══════════════ Alerts ═══════════════
alertcondition(weak and not weak[1], "Weak volume", "Volume turned weak")
alertcondition(brk != 0, "Weak pool broken", "Weak-volume pool broken with volume")
alertcondition(hunt != 0, "HUNT", "Pool break in strong trend: targeting previous volume zone")
alertcondition(rej != 0, "HVN rejection", "Price rejected from a high-volume zone")

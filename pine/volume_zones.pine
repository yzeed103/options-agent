//@version=5
// Volume Zones: rolling volume profile HVN/POC/VA, weak-volume pools,
// pool breakouts hunting previous HVNs in a strong trend, HVN rejections.
// Mirrors vzones/indicator.py (profile built from past bars only).
indicator("Volume Zones", overlay=true, max_lines_count=100, max_boxes_count=500, max_labels_count=200)

lookback   = input.int(120, "Profile lookback (bars)", minval=20, maxval=500)
rows       = input.int(40, "Profile rows", minval=10, maxval=100)
vaPct      = input.float(0.70, "Value area %")
hvnMult    = input.float(1.5, "HVN = row vol > x * mean")
volMaLen   = input.int(20, "Volume SMA")
weakRatio  = input.float(0.80, "Weak volume: vol/SMA <")
weakBars   = input.int(4, "Bars to form a weak pool")
poolMaxAtr = input.float(2.5, "Pool max range (ATR)")
breakRatio = input.float(1.5, "Break volume: vol/SMA >=")
adxLen     = input.int(14, "ADX length")
adxStrong  = input.float(25, "Strong trend ADX >=")
minTgtAtr  = input.float(1.0, "Min target distance (ATR)")
maxTgtAtr  = input.float(12.0, "Max target distance (ATR)")
wickPct    = input.float(0.5, "Rejection wick share")
showHeat   = input.bool(true, "Show heatmap", group="Heatmap")
heatStep   = input.int(4, "Heatmap column width (bars)", minval=1, group="Heatmap")
heatMin    = input.float(0.30, "Hide rows below (0-1 of max)", group="Heatmap")
heatAlpha  = input.int(55, "Heatmap transparency", minval=0, maxval=95, group="Heatmap")
showSplit  = input.bool(true, "Show Up/Down profile on last bar", group="Heatmap")

atrV  = ta.atr(14)
volMa = ta.sma(volume, volMaLen)
vr    = volume / volMa
weak  = vr < weakRatio
[diP, diM, adxV] = ta.dmi(adxLen, adxLen)
emaF = ta.ema(close, 20)
emaS = ta.ema(close, 50)
trendDir = emaF > emaS and diP > diM ? 1 : emaF < emaS and diM > diP ? -1 : 0

// ---- rolling volume profile over bars [1 .. lookback] (past only) ----
var float[] rowVol = array.new_float(rows, 0.0)
pHi = ta.highest(high, lookback)[1]
pLo = ta.lowest(low, lookback)[1]
step = (pHi - pLo) / rows
float poc = na, float vah = na, float val = na
var float[] hvnLo = array.new_float()
var float[] hvnHi = array.new_float()
if bar_index > lookback and step > 0
    array.fill(rowVol, 0.0)
    for i = 1 to lookback
        bh = high[i], bl = low[i], bv = volume[i]
        rng = math.max(bh - bl, syminfo.mintick)
        r0 = math.max(0, math.min(rows - 1, int((bl - pLo) / step)))
        r1 = math.max(0, math.min(rows - 1, int((bh - pLo) / step)))
        for r = r0 to r1
            lo = pLo + r * step, hi = lo + step
            ov = math.max(0.0, math.min(bh, hi) - math.max(bl, lo))
            array.set(rowVol, r, array.get(rowVol, r) + bv * (bh == bl ? 1.0 : ov / rng))
    total = array.sum(rowVol)
    pocI = array.indexof(rowVol, array.max(rowVol))
    loI = pocI, hiI = pocI, acc = array.get(rowVol, pocI)
    while acc < vaPct * total and (loI > 0 or hiI < rows - 1)
        up = hiI < rows - 1 ? array.get(rowVol, hiI + 1) : -1.0
        dn = loI > 0 ? array.get(rowVol, loI - 1) : -1.0
        if up >= dn
            hiI += 1, acc += up
        else
            loI -= 1, acc += dn
    poc := pLo + (pocI + 0.5) * step
    vah := pLo + (hiI + 1) * step
    val := pLo + loI * step
    array.clear(hvnLo), array.clear(hvnHi)
    mean = total / rows
    inRun = false
    for r = 0 to rows - 1
        isH = array.get(rowVol, r) > hvnMult * mean
        if isH and not inRun
            array.push(hvnLo, pLo + r * step), array.push(hvnHi, pLo + (r + 1) * step), inRun := true
        else if isH and inRun
            array.set(hvnHi, array.size(hvnHi) - 1, pLo + (r + 1) * step)
        else
            inRun := false

// nearest HVN edges / targets
float tgtUp = na, float tgtDn = na
cands = array.new_float()
for k = 0 to array.size(hvnLo) - 1
    array.push(cands, array.get(hvnLo, k)), array.push(cands, array.get(hvnHi, k))
if not na(poc)
    array.push(cands, poc), array.push(cands, vah), array.push(cands, val)
for k = 0 to array.size(cands) - 1
    x = array.get(cands, k)
    d = math.abs(x - close) / atrV
    if d >= minTgtAtr and d <= maxTgtAtr
        if x > close and (na(tgtUp) or x < tgtUp)
            tgtUp := x
        if x < close and (na(tgtDn) or x > tgtDn)
            tgtDn := x
inHvn = false
for k = 0 to array.size(hvnLo) - 1
    if close >= array.get(hvnLo, k) and close <= array.get(hvnHi, k)
        inHvn := true

// ---- weak pool / break / hunt ----
var int poolStart = na
winRng = ta.highest(high, weakBars) - ta.lowest(low, weakBars)
weakCnt = math.sum(weak ? 1 : 0, weakBars)
if na(poolStart) and weakCnt >= weakBars - 1 and winRng <= poolMaxAtr * atrV
    poolStart := bar_index - weakBars + 1
int brk = 0, int hunt = 0
float poolH = na, float poolL = na, float huntTgt = na
if not na(poolStart)
    len = bar_index - poolStart
    if len >= 1
        poolH := ta.highest(high, len)[1]
        poolL := ta.lowest(low, len)[1]
    if not na(poolH) and close > poolH and vr >= breakRatio
        brk := 1
    else if not na(poolL) and close < poolL and vr >= breakRatio
        brk := -1
    if brk != 0
        t = brk > 0 ? tgtUp : tgtDn
        emaOk = brk > 0 ? emaF > emaS : emaF < emaS
        if not na(t) and adxV >= adxStrong and emaOk
            hunt := brk, huntTgt := t
        poolStart := na
    else if (high - low) > 0 and (poolH - poolL) > poolMaxAtr * atrV
        poolStart := na

// ---- rejection at HVN ----
int rej = 0
rngB = high - low
if rngB > 0
    uw = (high - math.max(open, close)) / rngB
    lw = (math.min(open, close) - low) / rngB
    for k = 0 to array.size(hvnLo) - 1
        lo = array.get(hvnLo, k), hi = array.get(hvnHi, k)
        if low < lo and high >= lo and close < lo and close < open and uw >= wickPct
            rej := -1
        if low <= hi and high > hi and close > hi and close > open and lw >= wickPct
            rej := 1

// ---- plots ----
plot(poc, "POC", color.new(color.yellow, 0), 2, plot.style_stepline)
plot(vah, "VAH", color.new(color.gray, 30), 1, plot.style_stepline)
plot(val, "VAL", color.new(color.gray, 30), 1, plot.style_stepline)
bgcolor(not na(poolStart) ? color.new(color.gray, 85) : na, title="Weak volume pool")
barcolor(weak ? color.new(color.gray, 40) : na, title="Weak volume bar")
plotshape(brk == 1 and hunt == 0, "Pool break up", shape.triangleup, location.belowbar, color.teal, size=size.tiny)
plotshape(brk == -1 and hunt == 0, "Pool break down", shape.triangledown, location.abovebar, color.maroon, size=size.tiny)
plotshape(hunt == 1, "HUNT up", shape.labelup, location.belowbar, color.lime, text="HUNT", textcolor=color.black)
plotshape(hunt == -1, "HUNT down", shape.labeldown, location.abovebar, color.red, text="HUNT", textcolor=color.white)
plotshape(rej == 1, "HVN rejection bull", shape.circle, location.belowbar, color.aqua, size=size.tiny)
plotshape(rej == -1, "HVN rejection bear", shape.circle, location.abovebar, color.orange, size=size.tiny)
if hunt != 0
    line.new(bar_index, huntTgt, bar_index + 20, huntTgt, color=hunt > 0 ? color.lime : color.red, style=line.style_dashed)
if barstate.islast
    for k = 0 to array.size(hvnLo) - 1
        box.new(bar_index - lookback, array.get(hvnHi, k), bar_index + 5, array.get(hvnLo, k), border_color=na, bgcolor=color.new(color.blue, 85))

alertcondition(weak and not weak[1], "Weak volume", "Volume turned weak")
alertcondition(brk != 0, "Weak pool broken", "Weak-volume pool broken with volume")
alertcondition(hunt != 0, "HUNT", "Pool break in strong trend: targeting previous HVN")
alertcondition(rej != 0, "HVN rejection", "Price rejected from a high-volume zone")

// ---- heatmap: every `heatStep` bars draw one column of boxes, one per profile row ----
heatColor(x) =>
    x < 0.45 ? color.from_gradient(x, heatMin, 0.45, #1e3a5f, #2a6f97) :
     x < 0.65 ? color.from_gradient(x, 0.45, 0.65, #2a6f97, #3d8b5a) :
     x < 0.85 ? color.from_gradient(x, 0.65, 0.85, #8bbf3c, #e8c547) :
     color.from_gradient(x, 0.85, 1.0, #e8c547, #e8432d)
var box[] heatBoxes = array.new_box()
if showHeat and bar_index > lookback and step > 0 and bar_index % heatStep == 0
    mx = array.max(rowVol)
    for r = 0 to rows - 1
        x = mx > 0 ? array.get(rowVol, r) / mx : 0.0
        if x >= heatMin
            b = box.new(bar_index, pLo + (r + 1) * step, bar_index + heatStep, pLo + r * step,
                 border_color=na, bgcolor=color.new(heatColor(x), heatAlpha))
            array.push(heatBoxes, b)
    while array.size(heatBoxes) > 440
        box.delete(array.shift(heatBoxes))

// ---- Up/Down split profile (buy = up bars, sell = down bars) at the right edge ----
var box[] splitBoxes = array.new_box()
if showSplit and barstate.islast and step > 0
    for b in splitBoxes
        box.delete(b)
    array.clear(splitBoxes)
    upV = array.new_float(rows, 0.0), dnV = array.new_float(rows, 0.0)
    for i = 1 to lookback
        r = math.max(0, math.min(rows - 1, int((hl2[i] - pLo) / step)))
        if close[i] >= open[i]
            array.set(upV, r, array.get(upV, r) + volume[i])
        else
            array.set(dnV, r, array.get(dnV, r) + volume[i])
    tot = 0.0
    for r = 0 to rows - 1
        tot := math.max(tot, array.get(upV, r) + array.get(dnV, r))
    width = 40
    for r = 0 to math.min(rows, 29) - 1
        rr = rows <= 29 ? r : int(r * rows / 29)
        u = int(width * array.get(upV, rr) / tot), d = int(width * array.get(dnV, rr) / tot)
        if u > 0
            array.push(splitBoxes, box.new(bar_index + 8, pLo + (rr + 1) * step, bar_index + 8 + u, pLo + rr * step, border_color=na, bgcolor=color.new(#2f7fd1, 20)))
        if d > 0
            array.push(splitBoxes, box.new(bar_index + 8 + u, pLo + (rr + 1) * step, bar_index + 8 + u + d, pLo + rr * step, border_color=na, bgcolor=color.new(#c9a227, 20)))
